# ---------------------------------------------------------------------------
# Every environment variable the project reads or needs set, by component. NAMES ONLY: no values,
# and no secret ever goes in this file. Each entry says where it is used and whether it is secret;
# a default, when there is one, is in the comment. Real values live in Secret Manager (API,
# gateway), the Vercel project (web apps), the CircleCI contexts (pipeline) and your shell.
#
# Per-component files with the same names and fuller notes:
#   backend/.env.example           the API (pydantic-settings fields; no prefix)
#   services/realtime/.env.example the realtime gateway
#   apps/booking/.env.example      the patient app
#   apps/admin/.env.example        the staff app
# scripts/check_env_example.py fails `make lint` when a name read in code is missing here or there.
# ---------------------------------------------------------------------------

# ---- API (backend/app/core/config.py, backend/migrations/env.py) -------------------------------
# asyncpg URL (postgresql+asyncpg://...), secret. Rejects sslmode/channel_binding; use ?ssl=require.
# Migrations read the same name but are given the owner role's URL.
DATABASE_URL=
# Pool size, default 5.
DB_POOL_SIZE=
# Shortest notice for a booking in minutes, default 60.
BOOKING_MIN_LEAD_MINUTES=
# How far ahead a booking may be made in days, default 90.
BOOKING_HORIZON_DAYS=
# IANA zone for timestamps that belong to no clinic, default Africa/Nairobi.
DEFAULT_CLINIC_TZ=
# Emails a day / a month (Resend free plan), defaults 100 and 3000. Also read by docker-compose.yml.
EMAIL_DAILY_LIMIT=
EMAIL_MONTHLY_LIMIT=
# Most reminders one run may claim, default 50.
REMINDER_RUN_LIMIT=
# Daily allowance kept free of reminders, default 20. Also read by docker-compose.yml.
EMAIL_ACK_RESERVE=
# Minutes a claimed reminder is leased, default 15.
REMINDER_LEASE_MINUTES=
# Port uvicorn (API) and the gateway listen on, default 8080. Cloud Run sets it.
PORT=
# CORS origin and the site that may ask for live-update tokens, default http://localhost:3000.
WEB_ORIGIN=
# The API's public base URL, default http://localhost:8080.
PUBLIC_BASE_URL=
# Log level, default info.
LOG_LEVEL=
# Commit the build came from, default unknown (set by the deploy).
GIT_SHA=
# HMAC key shared by the API, the gateway and both web apps. Secret, 32+ characters.
INTERNAL_SIGNING_KEY=
# Second HMAC key held only by the release smoke test (API and gateway). Secret, 32+ characters,
# must differ from INTERNAL_SIGNING_KEY.
SMOKE_SIGNING_KEY=
# Comma-separated owner emails (API, gateway and admin app, which must agree). Not secret.
ADMIN_EMAILS=
# Staff CRUD rollback switch, default true.
STAFF_CRUD_ENABLED=
# Staff writes per person per window (default 60) and the window in seconds (default 600).
STAFF_WRITE_LIMIT=
STAFF_WRITE_WINDOW_SECONDS=
# Ably API key (API; also the CI ably-ci context and the e2e runs). Secret. Unset turns push off.
ABLY_API_KEY=
# Ably endpoints, defaults https://main.realtime.ably.net and .../event-stream.
ABLY_REST_URL=
ABLY_STREAM_URL=
# Publishes a month, at most 25000 (start-up refuses more), default 25000.
REALTIME_PUBLISH_CAP_PER_MONTH=
# Seconds a write waits on the push relay (default 2.0), age in seconds past which an event is not
# pushed (default 600), tokens a client may fetch a minute (default 10) and a day in total (default 500).
REALTIME_RELAY_TIMEOUT_SECONDS=
REALTIME_MAX_EVENT_AGE_SECONDS=
REALTIME_TOKEN_PER_MINUTE=
REALTIME_TOKEN_DAILY_CAP=

# ---- Realtime gateway (services/realtime/internal/config/config.go) ---------------------------
# Also: PORT, DATABASE_URL (the clinic_realtime role, secret), INTERNAL_SIGNING_KEY,
# SMOKE_SIGNING_KEY and ADMIN_EMAILS above. Durations use Go syntax (30s).
# Streams per instance and per person, defaults 1 and 1.
MAX_STREAMS_PER_INSTANCE=
MAX_STREAMS_PER_PERSON=
# Poll interval, default 1s.
POLL_INTERVAL=
# Heartbeat interval, default 30s; start-up refuses less than 25s (cost guard).
HEARTBEAT_INTERVAL=
# Hard ceiling on one stream, default 290s.
MAX_CONNECTION=
# Closes a stream with no appointment event for this long, default 240s.
IDLE_TIMEOUT=
# How often an open stream re-reads the person's role, default 30s.
ROLE_RECHECK=
# Database connections per instance, 1 or 2, default 2.
DB_MAX_CONNS=
# Drain time on shutdown, default 8s.
SHUTDOWN_TIMEOUT=
# Base URL of problem-details type links, default https://clinic.invalid.
PROBLEMS_BASE_URL=

# ---- Web apps (apps/booking, apps/admin, packages/api); Vercel project environment -------------
# Sign-in, both apps. The Google OAuth client id and secret are secret, as is the session secret
# (`openssl rand -base64 32`). BETTER_AUTH_URL is the app's own origin and is not secret.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
# Proxy to the Cloud Run API. All marked sensitive in Vercel: API base URL, ID-token audience
# (default clinic-api), Google project number, impersonated service account, workload identity
# pool and provider ids.
API_URL=
API_AUDIENCE=
GCP_PROJECT_NUMBER=
GCP_SERVICE_ACCOUNT_EMAIL=
GCP_WORKLOAD_IDENTITY_POOL_ID=
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=
# Gateway base URL behind /api/stream (booking) and /live/stream (admin), and its ID-token
# audience (default clinic-realtime). Not secret.
REALTIME_URL=
REALTIME_AUDIENCE=
# Requests a minute per client at the booking proxy, default 120. Not secret.
RATE_LIMIT_PER_MINUTE=
# Resend API key (booking and admin). Secret. Base URL override, default https://api.resend.com.
RESEND_API_KEY=
RESEND_BASE_URL=
# Shared secret Vercel Cron sends to /cron/reminders (booking). Secret.
CRON_SECRET=
# reCAPTCHA (booking): public site key (inlined at build; see scripts/ci/public-build.env), the
# service account the server impersonates (sensitive), lowest accepted score (default 0.5), and the
# test-only switch that turns the check off (needs E2E=1 or NODE_ENV=test; production always checks).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SERVICE_ACCOUNT_EMAIL=
RECAPTCHA_MIN_SCORE=
RECAPTCHA_ENFORCE=
# Extra connect-src origins for the local push stand-in only (booking). Not secret.
CSP_EXTRA_CONNECT=
# Set by the platform, never by hand: NODE_ENV, VERCEL, VERCEL_ENV (and CI by the runner).

# ---- Local stack (docker-compose.yml, Makefile, scripts/api_check.sh, scripts/e2e_admin.sh) ----
# Host ports for the compose database, API and gateway, defaults 5432, 8080 and 8090.
DB_HOST_PORT=
API_HOST_PORT=
REALTIME_HOST_PORT=
# Compose project name and host ports for isolated runs: make e2e (E2E_PROJECT, E2E_API_PORT,
# E2E_DB_PORT) and scripts/api_check.sh (API_CHECK_*).
COMPOSE_PROJECT_NAME=
E2E_PROJECT=
E2E_API_PORT=
E2E_DB_PORT=
API_CHECK_PROJECT=
API_CHECK_API_PORT=
API_CHECK_DB_PORT=
API_CHECK_LONG_LEAD_PORT=
# api_check.sh: 1 adds the booking writes / keeps the stack up; report directory.
API_WRITES=
KEEP_STACK=
REPORT_DIR=

# ---- End-to-end and test runs only; never set in a deployed environment ------------------------
# Not secret unless marked.
E2E=
E2E_API_URL=
E2E_REALTIME_URL=
REAL_API_URL=
# Throwaway Postgres URL with a password (secret).
E2E_DB_URL=
E2E_PUSH_LOCAL=
FAKE_PUSH_PORT=
# Throwaway shared secret of the local push stand-in (secret).
FAKE_PUSH_SECRET=
RESEND_STANDIN_PORT=
E2E_EXPECT_SITE_KEY=
E2E_PUBLIC_BUILD=
E2E_CHECK_EXTERNAL=
E2E_STATE=
SHELL_E2E=
ADMIN_E2E_PORT=
ADMIN_E2E_CPU_THROTTLE=
PW_CHROME_PATH=
PW_BUNDLED=
PW_CPU_THROTTLE=
FONTS_E2E_CPU_THROTTLE=
ARCH_SHOTS=
# Test database and roles (backend/tests/conftest.py); the passwords are throwaways (secret).
TEST_DB_HOST=
TEST_DB_PORT=
TEST_DB_NAME=
TEST_OWNER_USER=
TEST_OWNER_PASSWORD=
TEST_APP_USER=
TEST_APP_PASSWORD=
TEST_FIXED_NOW=
# Gateway tests (services/realtime): owner and gateway DSNs (secret), API URL and its signing key (secret).
TEST_OWNER_DSN=
TEST_REALTIME_DSN=
TEST_API_URL=
TEST_API_SIGNING_KEY=

# ---- CircleCI (.circleci/config.yml, rollback.yml, scripts/ci) ---------------------------------
# Context gcp-deploy (build-scan-push, ship-api, ship-realtime, rollback): GCP project id and
# number, the deployer service account (scripts/ci/gcp_login.sh) and the API's public and web
# origins. None is a secret. CircleCI supplies CIRCLE_OIDC_TOKEN_V2, CIRCLE_SHA1, CIRCLE_BRANCH
# and CIRCLE_BUILD_URL itself.
GOOGLE_PROJECT_ID=
GOOGLE_PROJECT_NUMBER=
DEPLOYER_SA=
# (PUBLIC_BASE_URL and WEB_ORIGIN above are also required in this context.)
# Context vercel-prod (ship-app, rollback-app): Vercel org id and the booking project id (not
# secret; VERCEL_PROJECT_ID is overridden per app by the job), and the project tokens (secret).
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
VERCEL_TOKEN=
VERCEL_ADMIN_TOKEN=
# Context ably-ci (ably-real, e2e-real): ABLY_API_KEY above, a CI-only key (secret).
# Context oidc-probe: empty by design (scripts/ci/deny_probe.sh proves it).
# Set inside jobs, not in a context: OWNER_EMAILS (the one place owners are listed, exported to
# the deploy as ADMIN_EMAILS), VERCEL_APP, CRON_SECRET and the throwaway signing keys of the e2e jobs.
OWNER_EMAILS=
VERCEL_APP=
# Script knobs (all optional, defaults in the scripts): service / region / promoted-state directory
# of promote.sh, prune.sh, rollback.sh, realtime_prereqs.sh and realtime_live_check.sh; the image
# package prune.sh keeps; the seconds realtime_live_check.sh holds a stream.
SERVICE=
REGION=
PROMOTE_DIR=
AR_PACKAGE=
LIVE_CHECK_SECONDS=
# realtime_live_check.sh inputs: the gateway URL and an ID token for it (secret); the curl binary.
URL=
TOKEN=
CURL=
# vercel_offline_build.sh: app directory, repo root, public build values file, build command and target.
VERCEL_APP_DIR=
REPO_ROOT=
PUBLIC_ENV_FILE=
VERCEL_BUILD_CMD=
VERCEL_BUILD_TARGET=
# Lighthouse (scripts/ci/lighthouse.sh): port, Chrome path, server and run commands, watched
# paths, output directory.
LH_PORT=
LH_CHROME_PATH=
LH_SERVER_CMD=
LH_RUN_CMD=
LH_WATCH=
LHCI_OUTPUT_DIR=
# Gitleaks install (scripts/ci/install_gitleaks.sh): download URL, checksum override (test seam),
# cache directory, retry sleep.
GITLEAKS_URL=
GITLEAKS_SHA256=
GITLEAKS_CACHE=
GITLEAKS_RETRY_SLEEP=
# ZAP baseline: container runtime binary. Repo hygiene: allow-list file. Not-configured smoke: apps directory.
ZAP_DOCKER=
HYGIENE_ALLOW=
APPS_DIR=
# Deny probes (scripts/ci/deny_probe.sh), tests and dry runs only: endpoint overrides.
PROBE_RUN_APP_URL=
PROBE_STS_URL=
# Public identifiers committed in files, not set in the environment: scripts/ci/public-urls.env
# (WEB, ADMIN, RUN_APP_URL), scripts/ci/wif-probe.env (WIF_PROJECT_NUMBER, WIF_POOL, WIF_PROVIDER)
# and scripts/ci/public-build.env (one NEXT_PUBLIC_* value per app).

# ---- Cost and operations scripts (scripts/cost_check.sh, scripts/ops, infra/bootstrap.sh) -------
# cost_check.sh --live: PROJECT (required), the gcloud account to use, the billing account and the
# gcloud account that may read it, the Neon project id, and the checks CI may leave unverified.
# None is a secret.
PROJECT=
GCLOUD_ACCOUNT=
BILLING_ACCOUNT=
BILLING_GCLOUD_ACCOUNT=
NEON_PROJECT_ID=
COST_CHECK_ALLOW_UNVERIFIED=
# infra/bootstrap.sh: DRY_RUN=1 prints the commands without running them. PROJECT, GCLOUD_ACCOUNT
# and BILLING_ACCOUNT above are its inputs.
DRY_RUN=
# scripts/ops/kill_switch.sh: where the snapshot of removed access is kept.
KILL_SWITCH_STATE=
# scripts/ops/measure_realtime_cost.sh: evidence file, README path, vCPU-second budget an hour
# (default 1100) and shared headroom (default 21619).
EVIDENCE=
README=
BUDGET_VCPU_S_PER_HOUR=
SHARED_HEADROOM_VCPU_S=
# scripts/ops/purge_synthetic.sh: the owner role's connection string. Secret.
PURGE_DATABASE_URL=
# scripts/ci/realtime_smoke.py inputs (set by the job): ID tokens for the API and the gateway, secret.
API_TOKEN=
REALTIME_TOKEN=

# ---- Terraform (infra/terraform/variables.tf; same names as terraform.tfvars.example) -----------
# Pass as terraform.tfvars entries (project_id, ...) or as TF_VAR_<name>. Identifiers only; none is
# a secret and no secret belongs in state.
# GCP project id and number.
TF_VAR_project_id=
TF_VAR_project_number=
# Cloud Run and Artifact Registry region, default us-east4.
TF_VAR_region=
# CircleCI organization id and project id (OIDC issuer segment, audience and subject condition).
TF_VAR_circleci_org_id=
TF_VAR_circleci_project_id=
# UUID of the CircleCI gcp-deploy context; only jobs using it can mint the deployer token.
TF_VAR_circleci_gcp_deploy_context_id=
# Vercel team slug (OIDC issuer segment and subject condition).
TF_VAR_vercel_team=
# Recipient of the egress alert.
TF_VAR_alert_email=
# owner/name of the GitHub repository, default ericgitangu/clinic-booking.
TF_VAR_github_repository=
