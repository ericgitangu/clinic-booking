# ---------------------------------------------------------------------------
# Every environment variable the project reads or needs set, by component, with the local default.
#
# Value rules:
#   - Secrets (keys, tokens, passwords, signing keys, client secrets, URLs with a password) are
#     always empty here. Each one's comment says where the real value lives: Secret Manager (API,
#     gateway), the Vercel project (web apps), a CircleCI context (pipeline) or your own shell.
#   - Everything else shows the default the code, docker-compose.yml or the Makefile uses, or the
#     value that makes `make up` work locally. Empty non-secret lines mean the default is derived at
#     run time (named in the comment) or is "off".
#   - Empty is not always the same as unset: some reads use `??` or `os.environ.get`, which keep an
#     empty string. Delete a line you do not want rather than blanking it.
# scripts/check_env_example.py fails `make lint` if a name read in code is missing, a listed name
# is stale, a secret-named variable has a value, or any value looks like a real credential.
#
# Per-component files with the same names and fuller notes:
#   backend/.env.example           the API (pydantic-settings fields; no prefix)
#   services/realtime/.env.example the realtime gateway
#   apps/booking/.env.example      the patient app
#   apps/admin/.env.example        the staff app
# ---------------------------------------------------------------------------

# ---- API (backend/app/core/config.py, backend/migrations/env.py) -------------------------------
# asyncpg URL (postgresql+asyncpg://...) of the runtime role. Required, SECRET, empty here. Rejects
# sslmode/channel_binding; use ?ssl=require. docker-compose.yml sets it locally. Cloud Run: Secret
# Manager clinic-database-url-app; migrations get the owner URL (clinic-database-url-migrate).
DATABASE_URL=
# SQLAlchemy pool size. Optional, not secret. Default 5.
DB_POOL_SIZE=5
# Shortest notice for a booking in minutes. Optional, not secret. Default 60.
BOOKING_MIN_LEAD_MINUTES=60
# How far ahead a booking may be made in days. Optional, not secret. Default 90.
BOOKING_HORIZON_DAYS=90
# IANA zone for timestamps that belong to no clinic. Optional, not secret. Default Africa/Nairobi.
DEFAULT_CLINIC_TZ=Africa/Nairobi
# Emails a day (Resend free plan). Optional, not secret. Default 100. Also read by docker-compose.yml.
EMAIL_DAILY_LIMIT=100
# Emails a calendar month (UTC). Optional, not secret. Default 3000.
EMAIL_MONTHLY_LIMIT=3000
# Most reminders one run may claim. Optional, not secret. Default 50.
REMINDER_RUN_LIMIT=50
# Daily allowance kept free of reminders, for acknowledgements. Optional, not secret. Default 20.
EMAIL_ACK_RESERVE=20
# Minutes a claimed reminder is leased. Optional, not secret. Default 15.
REMINDER_LEASE_MINUTES=15
# Port uvicorn (API) and the gateway listen on. Optional, not secret. Default 8080; Cloud Run sets it.
PORT=8080
# CORS origin and the site that may ask for live-update tokens. Optional, not secret.
# Default http://localhost:3000 (the booking app's dev server).
WEB_ORIGIN=http://localhost:3000
# The API's public base URL. Optional, not secret. Default http://localhost:8080.
PUBLIC_BASE_URL=http://localhost:8080
# Log level. Optional, not secret. Default info.
LOG_LEVEL=info
# Commit the build came from; the deploy sets it. Optional, not secret. Default unknown.
GIT_SHA=unknown
# HMAC key shared by the API, the gateway and both web apps. SECRET, empty here, 32+ characters.
# Generate: openssl rand -hex 32. Secret Manager clinic-internal-signing-key; Vercel project env.
# Unset closes every /internal/* route.
INTERNAL_SIGNING_KEY=
# Second HMAC key held only by the release smoke test (API and gateway). SECRET, empty here,
# 32+ characters, must differ from INTERNAL_SIGNING_KEY. Generate: openssl rand -hex 32.
# Secret Manager clinic-smoke-signing-key.
SMOKE_SIGNING_KEY=
# Comma-separated owner emails (API, gateway and admin app, which must agree). Optional, not
# secret. Default empty (no owner). Set your own address locally to use the admin app.
ADMIN_EMAILS=
# Staff CRUD rollback switch. Optional, not secret. Default true.
STAFF_CRUD_ENABLED=true
# Staff writes per person per window. Optional, not secret. Default 60.
STAFF_WRITE_LIMIT=60
# Length of that window in seconds. Optional, not secret. Default 600.
STAFF_WRITE_WINDOW_SECONDS=600
# Ably API key (API; also the CI ably-ci context and the e2e runs). SECRET, empty here. Optional:
# empty turns push off and clients poll. Secret Manager clinic-ably-api-key (infra/terraform/ably.tf).
ABLY_API_KEY=
# Ably REST endpoint. Optional, not secret. Default https://main.realtime.ably.net.
ABLY_REST_URL=https://main.realtime.ably.net
# Ably event-stream endpoint. Optional, not secret. Default https://main.realtime.ably.net/event-stream.
ABLY_STREAM_URL=https://main.realtime.ably.net/event-stream
# Publishes a month. Optional, not secret. Default 25000, also the ceiling (start-up refuses more).
REALTIME_PUBLISH_CAP_PER_MONTH=25000
# Seconds a write waits on the push relay. Optional, not secret. Default 2.0.
REALTIME_RELAY_TIMEOUT_SECONDS=2.0
# Age in seconds past which an event is not pushed. Optional, not secret. Default 600.
REALTIME_MAX_EVENT_AGE_SECONDS=600
# Live-update tokens one client may fetch a minute. Optional, not secret. Default 10.
REALTIME_TOKEN_PER_MINUTE=10
# Live-update tokens issued a day in total. Optional, not secret. Default 500.
REALTIME_TOKEN_DAILY_CAP=500

# ---- Realtime gateway (services/realtime/internal/config/config.go) ---------------------------
# Also: PORT, DATABASE_URL (the clinic_realtime role, SECRET, Secret Manager
# clinic-database-url-realtime), INTERNAL_SIGNING_KEY, SMOKE_SIGNING_KEY and ADMIN_EMAILS above.
# Durations use Go syntax (30s). Empty means the default here.
# Streams one instance serves at once. Optional, not secret. Default 1.
MAX_STREAMS_PER_INSTANCE=1
# Streams one person may hold at once. Optional, not secret. Default 1.
MAX_STREAMS_PER_PERSON=1
# How often the event log is polled. Optional, not secret. Default 1s.
POLL_INTERVAL=1s
# Heartbeat interval. Optional, not secret. Default 30s; start-up refuses less than 25s (cost guard).
HEARTBEAT_INTERVAL=30s
# Hard ceiling on one stream. Optional, not secret. Default 290s.
MAX_CONNECTION=290s
# Closes a stream with no appointment event for this long. Optional, not secret. Default 240s.
IDLE_TIMEOUT=240s
# How often an open stream re-reads the person's role. Optional, not secret. Default 30s
# (docker-compose.yml sets 2s for the e2e).
ROLE_RECHECK=30s
# Database connections per instance, 1 or 2. Optional, not secret. Default 2.
DB_MAX_CONNS=2
# Drain time on shutdown. Optional, not secret. Default 8s.
SHUTDOWN_TIMEOUT=8s
# Base URL of problem-details type links. Optional, not secret. Default https://clinic.invalid.
PROBLEMS_BASE_URL=https://clinic.invalid

# ---- Web apps (apps/booking, apps/admin, packages/api); Vercel project environment -------------
# Google OAuth client id, both apps. Required for sign-in. Treated as SECRET (Sensitive in Vercel),
# empty here; from the OAuth client in Google Cloud (APIs & Services > Credentials).
GOOGLE_CLIENT_ID=
# Google OAuth client secret from the same client. Required for sign-in. SECRET, empty here.
GOOGLE_CLIENT_SECRET=
# Signs the session cookie. Required for sign-in. SECRET, empty here. Generate:
# openssl rand -base64 32 (the code only checks it is not empty).
BETTER_AUTH_SECRET=
# The app's own origin, a full URL. Required for sign-in, not secret. No default; locally
# http://localhost:3000 for booking (the admin app uses its own port, see apps/admin/.env.example).
BETTER_AUTH_URL=http://localhost:3000
# Base URL of the API the server side calls. Required (empty answers 503). Not secret locally,
# Sensitive in Vercel. Local value: the compose API.
API_URL=http://localhost:8080
# ID-token audience for the API (Vercel only). Optional, not secret. Default clinic-api.
API_AUDIENCE=clinic-api
# Google Cloud project number for the Vercel token exchange. Required on Vercel, unused locally.
# Not a credential but Sensitive in Vercel, so empty here.
GCP_PROJECT_NUMBER=
# Service account the Vercel identity impersonates. Required on Vercel, unused locally. Sensitive
# in Vercel, empty here.
GCP_SERVICE_ACCOUNT_EMAIL=
# Workload identity pool id. Optional, not secret. Default vercel (infra/terraform/wif_vercel.tf).
GCP_WORKLOAD_IDENTITY_POOL_ID=vercel
# Workload identity pool provider id. Optional, not secret. Default vercel.
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=vercel
# Gateway base URL behind /api/stream (booking) and /live/stream (admin). Optional, not secret.
# No default; local value: the compose gateway (`docker compose --profile realtime up`).
REALTIME_URL=http://localhost:8090
# ID-token audience for the gateway (Vercel only). Optional, not secret. Default clinic-realtime.
REALTIME_AUDIENCE=clinic-realtime
# Requests a minute per client at the booking proxy. Optional, not secret. Default 120.
RATE_LIMIT_PER_MINUTE=120
# Resend API key (booking and admin). SECRET, empty here; Vercel project env. Optional: empty
# turns email off.
RESEND_API_KEY=
# Resend base URL. Optional, not secret. Default https://api.resend.com (only test stand-ins change it).
RESEND_BASE_URL=https://api.resend.com
# Shared secret Vercel Cron sends to /cron/reminders (booking). SECRET, empty here, 16+ characters.
# Generate: openssl rand -hex 32.
CRON_SECRET=
# Public reCAPTCHA site key (booking), inlined at build. Public by design but key-shaped, so empty
# here; the CI build value is in scripts/ci/public-build.env.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# Service account the booking server impersonates for reCAPTCHA. Required when the check runs.
# Sensitive in Vercel, empty here.
RECAPTCHA_SERVICE_ACCOUNT_EMAIL=
# Lowest accepted reCAPTCHA score. Optional, not secret. Default 0.5.
RECAPTCHA_MIN_SCORE=0.5
# Test-only switch: "false" turns the check off, but only on a test run (E2E=1 or NODE_ENV=test,
# localhost BETTER_AUTH_URL, not Vercel production). Optional, not secret. Default: enforced.
RECAPTCHA_ENFORCE=
# Extra connect-src origins for the local push stand-in only (booking). Optional, not secret.
# Default empty.
CSP_EXTRA_CONNECT=
# Set by the platform, never by hand: NODE_ENV, VERCEL, VERCEL_ENV (and CI by the runner).

# ---- Local stack (docker-compose.yml, Makefile, scripts/api_check.sh, scripts/e2e_admin.sh) ----
# Host port of the compose Postgres (the tests follow it). Optional, not secret. Default 5432.
DB_HOST_PORT=5432
# Host port of the compose API. Optional, not secret. Default 8080.
API_HOST_PORT=8080
# Host port of the compose gateway. Optional, not secret. Default 8090.
REALTIME_HOST_PORT=8090
# Compose project name. Optional, not secret. Empty: compose uses the directory name, and
# `make e2e` / scripts/e2e_admin.sh set their own (clinic-e2e).
COMPOSE_PROJECT_NAME=
# `make e2e` compose project. Optional, not secret. Default clinic-e2e.
E2E_PROJECT=clinic-e2e
# `make e2e` API host port. Optional, not secret. Default 18080.
E2E_API_PORT=18080
# `make e2e` Postgres host port. Optional, not secret. Default 15432.
E2E_DB_PORT=15432
# scripts/api_check.sh compose project. Optional, not secret. Default clinic-apicheck.
API_CHECK_PROJECT=clinic-apicheck
# api_check.sh API host port. Optional, not secret. Empty: the first free port from 18180.
API_CHECK_API_PORT=
# api_check.sh Postgres host port. Optional, not secret. Empty: the first free port from 15532.
API_CHECK_DB_PORT=
# api_check.sh port of the long-lead second API. Optional, not secret. Empty: the next free port
# after the API's.
API_CHECK_LONG_LEAD_PORT=
# api_check.sh: 1 adds the booking writes. Optional, not secret. Default 0.
API_WRITES=0
# api_check.sh and e2e_admin.sh: 1 keeps the stack up afterwards. Optional, not secret. Default 0.
KEEP_STACK=0
# api_check.sh report directory. Optional, not secret. Empty: a fresh mktemp -d directory.
REPORT_DIR=

# ---- End-to-end and test runs only; never set in a deployed environment ------------------------
# Marks a local run as a test run (relaxes reCAPTCHA with RECAPTCHA_ENFORCE=false and the sign-in
# rate limit). Optional, not secret. Default unset; only 1 counts.
E2E=
# API the Playwright runs point the apps at. Optional, not secret. Default http://127.0.0.1:8080.
E2E_API_URL=http://127.0.0.1:8080
# Gateway the admin e2e run points at. Optional, not secret. Default http://127.0.0.1:8090.
E2E_REALTIME_URL=http://127.0.0.1:8090
# API the booking real-API tests call. Required for those tests (`make e2e` sets 18080). Not secret.
REAL_API_URL=http://127.0.0.1:8080
# Postgres URL the booking e2e helpers use. Optional. SECRET (holds a password), empty here; the
# default is the compose database on 127.0.0.1:DB_HOST_PORT.
E2E_DB_URL=
# 1 runs the live-update scenarios against the local push stand-in. Optional, not secret. Default off.
E2E_PUSH_LOCAL=
# Port of the local push stand-in. Optional, not secret. Default 3199.
FAKE_PUSH_PORT=3199
# Shared secret of the local push stand-in. SECRET in form, empty here; it has a throwaway default
# and reads with ??, so delete the line rather than export it empty.
FAKE_PUSH_SECRET=
# Port of the local Resend stand-in (booking). Optional, not secret. Default 3198.
RESEND_STANDIN_PORT=3198
# Site key the public build was made with (scripts/ci/public-build.env). Required with
# E2E_PUBLIC_BUILD. Public, but key-shaped, so empty here.
E2E_EXPECT_SITE_KEY=
# 1 runs the reCAPTCHA script scenario against a public build. Optional, not secret. Default off.
E2E_PUBLIC_BUILD=
# 1 also checks external links. Optional, not secret. Default off.
E2E_CHECK_EXTERNAL=
# Seeded appointments as JSON, written by apps/admin/e2e/global-setup.ts. Never set by hand.
E2E_STATE=
# 1 builds the e2e-only error page and route. Optional, not secret. Default off; never in a real build.
SHELL_E2E=
# Port the admin production build is served on in its e2e run. Optional, not secret. Default 3101.
ADMIN_E2E_PORT=3101
# Port of the admin e2e Resend stand-in. Optional, not secret. Default 3298.
ADMIN_E2E_RESEND_PORT=3298
# CPU slow-down factor for the admin performance scenarios. Optional, not secret. Default 1 (off).
ADMIN_E2E_CPU_THROTTLE=1
# Path to an installed Chrome for Playwright. Optional, not secret. Empty: the installed channel.
PW_CHROME_PATH=
# Any non-empty value uses Playwright's bundled Chromium (CI). Optional, not secret. Default off.
PW_BUNDLED=
# CPU slow-down factor for the booking performance scenarios. Optional, not secret. Default 1.
PW_CPU_THROTTLE=1
# CPU slow-down factor for the font scenarios. Optional, not secret. Default 1.
FONTS_E2E_CPU_THROTTLE=1
# Directory for architecture-page screenshots. Optional, not secret. Default off (none taken).
ARCH_SHOTS=
# Test database host (backend/tests/conftest.py). Optional, not secret. Default localhost.
TEST_DB_HOST=localhost
# Test database port. Optional, not secret. Default 5432; the Makefile sets it from DB_HOST_PORT.
TEST_DB_PORT=5432
# Test database name. Optional, not secret. Default clinic.
TEST_DB_NAME=clinic
# Owner role the tests migrate and seed with. Optional, not secret. Default clinic.
TEST_OWNER_USER=clinic
# Owner role password. SECRET by rule, empty here; delete the line to use the throwaway default
# (docker-compose.yml POSTGRES_PASSWORD), because conftest.py keeps an empty value.
TEST_OWNER_PASSWORD=
# Runtime role the tests connect as. Optional, not secret. Default clinic_app.
TEST_APP_USER=clinic_app
# Runtime role password. SECRET by rule, empty here; delete the line to use the throwaway default
# (backend/docker/initdb/01-roles.sql).
TEST_APP_PASSWORD=
# Fixed "now" of the test clock, ISO 8601 with offset. Optional, not secret. The value is the
# suite's own default (Monday 07:00 Nairobi); an empty value fails to parse.
TEST_FIXED_NOW=2026-10-19T04:00:00+00:00
# Gateway tests: owner-role DSN of the compose database. SECRET, empty here; services/realtime/Makefile
# sets it (?= does not override a set-but-empty value, so delete the line rather than blank it).
TEST_OWNER_DSN=
# Gateway tests: clinic_realtime DSN. SECRET, empty here; the same Makefile sets it.
TEST_REALTIME_DSN=
# Gateway tests: the running API's URL. Optional, not secret. Default http://127.0.0.1:8080.
TEST_API_URL=http://127.0.0.1:8080
# Gateway tests: that API's INTERNAL_SIGNING_KEY. SECRET, empty here, 32+ characters.
TEST_API_SIGNING_KEY=

# ---- CircleCI (.circleci/config.yml, rollback.yml, scripts/ci) ---------------------------------
# CircleCI supplies CIRCLE_OIDC_TOKEN_V2, CIRCLE_SHA1, CIRCLE_BRANCH and CIRCLE_BUILD_URL itself.
# Context gcp-deploy: GCP project id. Required in that context, not secret. No default.
GOOGLE_PROJECT_ID=
# Context gcp-deploy: GCP project number. Required there, not secret. No default.
GOOGLE_PROJECT_NUMBER=
# Context gcp-deploy: the deployer service account (scripts/ci/gcp_login.sh). Required there, not
# secret. No default.
DEPLOYER_SA=
# (PUBLIC_BASE_URL and WEB_ORIGIN above are also required in this context.)
# Context vercel-prod: Vercel org id. Required there, not secret. No default.
VERCEL_ORG_ID=
# Context vercel-prod: the booking project id; the job overrides it per app. Not secret. No default.
VERCEL_PROJECT_ID=
# Context vercel-prod: booking project token. SECRET, empty here; created in the Vercel dashboard.
VERCEL_TOKEN=
# Context vercel-prod: admin project token. SECRET, empty here; created in the Vercel dashboard.
VERCEL_ADMIN_TOKEN=
# Context ably-ci (ably-real, e2e-real): ABLY_API_KEY above, a CI-only key (SECRET).
# Context oidc-probe: empty by design (scripts/ci/deny_probe.sh proves it).
# Set inside a job: the owner list, exported to the deploy as ADMIN_EMAILS. Not secret. No default.
OWNER_EMAILS=
# Which web app vercel_prod.sh acts on: booking or admin. Optional, not secret. Default booking.
VERCEL_APP=booking
# Cloud Run service for promote.sh, prune.sh, rollback.sh and realtime_live_check.sh. Optional, not
# secret. Empty: each script's default (clinic-api, or clinic-realtime for the live check).
SERVICE=
# Cloud Run region for those scripts. Optional, not secret. Default us-east4.
REGION=us-east4
# Where promote.sh records the promoted revision and rollback.sh reads it. Optional, not secret.
# Empty: /tmp/promoted (API) or /tmp/promoted-realtime (live check).
PROMOTE_DIR=
# Image package prune.sh keeps. Optional, not secret. Empty:
# us-east4-docker.pkg.dev/<GOOGLE_PROJECT_ID>/clinic/clinic-api.
AR_PACKAGE=
# Seconds realtime_live_check.sh holds a stream. Optional, not secret. Default 60.
LIVE_CHECK_SECONDS=60
# realtime_live_check.sh: the gateway URL. Required by that script, not secret. No default.
URL=
# realtime_live_check.sh: an ID token for the gateway. Required by that script. SECRET, empty here;
# the job mints it.
TOKEN=
# realtime_live_check.sh: curl binary. Optional, not secret. Default curl.
CURL=curl
# vercel_offline_build.sh: app directory. Optional, not secret. Default apps/booking.
VERCEL_APP_DIR=apps/booking
# vercel_offline_build.sh: repository root. Optional, not secret. Empty: two levels above the script.
REPO_ROOT=
# vercel_offline_build.sh: public build values file. Optional, not secret.
# Default scripts/ci/public-build.env.
PUBLIC_ENV_FILE=scripts/ci/public-build.env
# vercel_offline_build.sh: build command override (test seam). Optional, not secret. Empty: vercel build.
VERCEL_BUILD_CMD=
# vercel_offline_build.sh: build target. Optional, not secret. Default production.
VERCEL_BUILD_TARGET=production
# Lighthouse (scripts/ci/lighthouse.sh): port. Optional, not secret. Default 3101.
LH_PORT=3101
# Lighthouse: Chrome path. Optional, not secret. Empty: Playwright's Chromium.
LH_CHROME_PATH=
# Lighthouse: server command override (test seam). Optional, not secret. Empty: next start on LH_PORT.
LH_SERVER_CMD=
# Lighthouse: run command override (test seam). Optional, not secret. Empty: lhci autorun.
LH_RUN_CMD=
# Lighthouse: paths whose change triggers a run. Optional, not secret. Empty: apps/ packages/ui/
# scripts/ci/lighthouse scripts/ci/lighthouse.sh scripts/ci/lighthouserc.cjs.
LH_WATCH=
# Lighthouse: output directory. Optional, not secret. Default /tmp/lighthouse.
LHCI_OUTPUT_DIR=/tmp/lighthouse
# Gitleaks install (scripts/ci/install_gitleaks.sh): download URL. Optional, not secret. Empty: the
# pinned GitHub release.
GITLEAKS_URL=
# Gitleaks install: checksum override (test seam). Optional, not secret. Empty: the pinned checksum
# in the script.
GITLEAKS_SHA256=
# Gitleaks install: cache directory. Optional, not secret. Empty: $HOME/.cache/gitleaks.
GITLEAKS_CACHE=
# Gitleaks install: seconds between download retries. Optional, not secret. Default 3.
GITLEAKS_RETRY_SLEEP=3
# ZAP baseline: container runtime binary. Optional, not secret. Default docker.
ZAP_DOCKER=docker
# Repo hygiene allow-list file. Optional, not secret. Default scripts/hygiene_allow.txt.
HYGIENE_ALLOW=scripts/hygiene_allow.txt
# Not-configured smoke: apps directory. Optional, not secret. Default apps.
APPS_DIR=apps
# Deny probe (tests and dry runs only): Cloud Run URL override. Optional, not secret. Empty: RUN_APP_URL
# from scripts/ci/public-urls.env.
PROBE_RUN_APP_URL=
# Deny probe: STS endpoint override. Optional, not secret. Default https://sts.googleapis.com/v1/token.
PROBE_STS_URL=https://sts.googleapis.com/v1/token
# Public identifiers committed in files, not set in the environment: scripts/ci/public-urls.env
# (WEB, ADMIN, RUN_APP_URL), scripts/ci/wif-probe.env (WIF_PROJECT_NUMBER, WIF_POOL, WIF_PROVIDER)
# and scripts/ci/public-build.env (one NEXT_PUBLIC_* value per app).

# ---- Cost and operations scripts (scripts/cost_check.sh, scripts/ops, infra/bootstrap.sh) -------
# GCP project id for cost_check.sh --live and infra/bootstrap.sh. Required by both, not secret. No default.
PROJECT=
# gcloud account to use. Required by bootstrap.sh; cost_check.sh uses the active account when empty.
# Not secret. No default.
GCLOUD_ACCOUNT=
# Billing account id. Required by bootstrap.sh project mode, optional for cost_check.sh. Not
# secret. No default.
BILLING_ACCOUNT=
# gcloud account that may read the budgets (cost_check.sh C11). Required for a local --live run
# (empty fails C11; CI marks it unverified). Not secret. No default.
BILLING_GCLOUD_ACCOUNT=
# Neon project id (cost_check.sh, with neonctl installed). Optional, not secret. Empty: Neon not checked.
NEON_PROJECT_ID=
# Space-separated check ids CI may leave unverified. Optional, not secret. Default empty (none).
COST_CHECK_ALLOW_UNVERIFIED=
# infra/bootstrap.sh: 1 prints the commands without running them. Optional, not secret. Default 0.
DRY_RUN=0
# scripts/ops/kill_switch.sh: snapshot of removed access. Optional, not secret. Empty:
# $HOME/.clinic-kill-switch/state.json.
KILL_SWITCH_STATE=
# scripts/ops/measure_realtime_cost.sh: evidence file. Optional, not secret. Empty:
# infra/evidence/realtime-cost.json.
EVIDENCE=
# measure_realtime_cost.sh: README to update. Optional, not secret. Empty: the repository README.md.
README=
# measure_realtime_cost.sh: vCPU-second budget an hour. Optional, not secret. Default 1100.
BUDGET_VCPU_S_PER_HOUR=1100
# measure_realtime_cost.sh: shared headroom in vCPU-seconds. Optional, not secret. Default 21619.
SHARED_HEADROOM_VCPU_S=21619
# scripts/ops/purge_synthetic.sh: the owner role's connection string. Required by that script.
# SECRET, empty here; export it in your shell for the one run.
PURGE_DATABASE_URL=
# scripts/ci/realtime_smoke.py: ID token for the API. Required by that script. SECRET, empty here;
# the job mints it.
API_TOKEN=
# realtime_smoke.py: ID token for the gateway. Required by that script. SECRET, empty here.
REALTIME_TOKEN=

# ---- Terraform (infra/terraform/variables.tf; same names as terraform.tfvars.example) -----------
# Pass as terraform.tfvars entries (project_id, ...) or as TF_VAR_<name>. Identifiers only; none is
# a secret and no secret belongs in state. Empty ones have no default: take your own values, with
# infra/terraform/terraform.tfvars.example as the template.
# GCP project id. Required, not secret.
TF_VAR_project_id=
# GCP project number. Required, not secret.
TF_VAR_project_number=
# Cloud Run and Artifact Registry region. Optional, not secret. Default us-east4.
TF_VAR_region=us-east4
# CircleCI organization id (OIDC issuer segment and audience). Required, not secret.
TF_VAR_circleci_org_id=
# CircleCI project id (OIDC subject condition). Required, not secret.
TF_VAR_circleci_project_id=
# UUID of the CircleCI gcp-deploy context; only jobs using it can mint the deployer token.
# Required, not secret.
TF_VAR_circleci_gcp_deploy_context_id=
# Vercel team slug (OIDC issuer segment and subject condition). Required, not secret.
TF_VAR_vercel_team=
# Recipient of the egress alert. Required, not secret. Use your own address.
TF_VAR_alert_email=
# owner/name of the GitHub repository. Optional, not secret. Default ericgitangu/clinic-booking.
TF_VAR_github_repository=ericgitangu/clinic-booking
