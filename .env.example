# ---------------------------------------------------------------------------
# Example environment. Copy to .env for local work. NO SECRETS LIVE IN THIS REPO.
# Placeholders only; real values come from Secret Manager / Vercel env / your shell.
# ---------------------------------------------------------------------------

# ---- Backend API (backend/app/core/config.py) ----
# asyncpg URL. A config validator REJECTS sslmode/channel_binding query params.
DATABASE_URL=postgresql+asyncpg://clinic_app:clinic_app_local@localhost:5432/clinic
DB_POOL_SIZE=5
BOOKING_MIN_LEAD_MINUTES=60
BOOKING_HORIZON_DAYS=90
WEB_ORIGIN=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:8080
LOG_LEVEL=info
GIT_SHA=unknown

# ---- Admin auth (STRETCH S3; inert until S3 ships) ----
ADMIN_AUTH_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
ADMIN_EMAILS=

# ---- Stream ticket / budget (STRETCH S1) ----
STREAM_TICKET_KEY=
STREAM_TICKET_TTL_SECONDS=60
STREAM_TICKET_DEBIT_SECONDS=700
STREAM_BUDGET_SECONDS=345600

# ---- Realtime gateway (services/realtime, in review in PR #71; env only) ----
POLL_INTERVAL_MS=1000
MAX_STREAMS_PER_INSTANCE=50
MAX_STREAMS_PER_IP=3
STREAM_MAX_SECONDS=290
HEARTBEAT_SECONDS=15
DB_MAX_CONNS=2
DB_MAX_CONN_IDLE_SECONDS=60
LAG_WARN_SECONDS=10
STREAM_AUTH_REQUIRED=false
TRUST_PROXY_CLIENT_IP=false
REALTIME_DATABASE_URL=postgresql://clinic_realtime:clinic_realtime_local@localhost:5432/clinic

# ---- Web proxy (web/; server-only Vercel env, identifiers only, no secrets) ----
API_URL=https://clinic-api-<hash>.us-east4.run.app
REALTIME_URL=
API_AUDIENCE=clinic-api
REALTIME_AUDIENCE=clinic-realtime
GCP_PROJECT_NUMBER=
GCP_WORKLOAD_IDENTITY_POOL_ID=vercel
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=vercel
GCP_SERVICE_ACCOUNT_EMAIL=clinic-web@<project>.iam.gserviceaccount.com
RATE_LIMIT_PER_MINUTE=120

# ---- Web stretch vars (S1/S3/S4; set only if that feature ships) ----
NEXT_PUBLIC_REALTIME_URL=
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=
