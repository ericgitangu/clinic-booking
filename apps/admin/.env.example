# Every variable the admin app reads (apps/admin/src and the packages/api code it imports), with no
# values. Set them in the clinic-admin Vercel project; locally put them in apps/admin/.env.local
# (gitignored). Vercel never returns Sensitive variables through `vercel env pull`, so those are
# tagged "sensitive: copy manually". Never write a secret into this file.

# --- Sign-in (Google, through Better Auth) -----------------------------------------------------
# OAuth client created in the sil-clinic-booking project.
# sensitive: copy manually
GOOGLE_CLIENT_ID=
# sensitive: copy manually
GOOGLE_CLIENT_SECRET=
# Signs and encrypts the session cookie. Generate with `openssl rand -base64 32`.
# sensitive: copy manually
BETTER_AUTH_SECRET=
# The admin site's own origin: http://localhost:3101 locally, its production origin when deployed.
BETTER_AUTH_URL=
# Comma-separated owner emails. Not secret. Must equal the API's and the gateway's value.
ADMIN_EMAILS=

# --- Calls to the API (Cloud Run, IAM-gated) ----------------------------------------------------
# Signs the assertion sent to the API's /internal endpoints; shared with the API and the gateway.
# sensitive: copy manually
INTERNAL_SIGNING_KEY=
# Base URL of the Cloud Run API service.
# sensitive: copy manually
API_URL=
# The custom audience the API accepts on the ID token. Default clinic-api.
# sensitive: copy manually
API_AUDIENCE=
# Google Cloud project number and the service account the Vercel identity impersonates, plus the
# workload identity pool and provider ids.
# sensitive: copy manually
GCP_PROJECT_NUMBER=
# sensitive: copy manually
GCP_SERVICE_ACCOUNT_EMAIL=
# sensitive: copy manually
GCP_WORKLOAD_IDENTITY_POOL_ID=
# sensitive: copy manually
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=

# --- Live feed ---------------------------------------------------------------------------------
# Base URL of the realtime gateway behind /live/stream. Not secret.
REALTIME_URL=
# The custom audience the gateway accepts on the ID token. Not secret. Default clinic-realtime.
REALTIME_AUDIENCE=

# --- Staff email -------------------------------------------------------------------------------
# Resend API key for invite and notice emails. Vercel environment only. Unset means email is off.
# sensitive: copy manually
RESEND_API_KEY=
# Base URL of the Resend API. Not secret. Default https://api.resend.com; only a test stand-in changes it.
RESEND_BASE_URL=

# --- Set by the platform, never by hand --------------------------------------------------------
# NODE_ENV (Next.js), VERCEL and VERCEL_ENV (Vercel). The app reads them to tell production from
# preview and local runs; they are not listed as assignments on purpose.

# --- End-to-end runs only (apps/admin/e2e, playwright.config.ts, scripts/e2e_admin.sh) ----------
# Not secret unless marked. Leave unset in every deployed environment.
# Set to 1 to build and serve the e2e-only error page (next.config.ts, playwright.config.ts).
SHELL_E2E=
# API and gateway the run points the app at.
E2E_API_URL=
E2E_REALTIME_URL=
# Port the app is served on. Default 3101.
ADMIN_E2E_PORT=
# Port of the Resend stand-in the run starts (the app's email goes there). Default 3298.
ADMIN_E2E_RESEND_PORT=
# Compose project of the stack the run uses.
COMPOSE_PROJECT_NAME=
# The seeded appointments as JSON, written by e2e/global-setup.ts for the specs; not set by hand.
E2E_STATE=
# Playwright browser: path to an installed Chrome, or a flag to use the bundled Chromium.
PW_CHROME_PATH=
PW_BUNDLED=
# CPU throttle factors for the performance scenarios.
ADMIN_E2E_CPU_THROTTLE=
FONTS_E2E_CPU_THROTTLE=
