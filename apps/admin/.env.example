# Environment for the admin app (apps/admin, plus the packages/api code it imports).
#
# Locally: copy this to apps/admin/.env.local (gitignored) and fill in the blanks. Deployed: set
# these in the clinic-admin Vercel project. Vercel never returns Sensitive variables through
# `vercel env pull`, so the secrets below are copied by hand. Never write a secret into this file.
#
# Each variable has a comment: what it does, whether it is required, its default, and whether it is
# a secret. Values shown are the local defaults the code or docker-compose.yml uses. A blank value
# (NAME=) means a secret or a value you must supply yourself.
#
# Without the Google values the app answers every page with a 503 "Sign-in is not configured" page
# and logs which names are missing. A real sign-in needs Google, so a reviewer without the Vercel
# project can run the e2e suite instead (`make e2e-admin`), which supplies its own test values.

# --- Sign-in (Google, through Better Auth) -----------------------------------------------------
# Google OAuth client id. Required (no sign-in without it). Secret: treated as sensitive, copy from
# the Vercel project (created in the sil-clinic-booking Google Cloud project).
GOOGLE_CLIENT_ID=
# Google OAuth client secret. Required. Secret: copy from the Vercel project or the Google Cloud
# console (APIs & Services > Credentials).
GOOGLE_CLIENT_SECRET=
# Signs and encrypts the session cookie. Required. Secret. You generate it: `openssl rand -base64 32`.
# The code only checks it is not empty (packages/api/src/auth-env.ts). Changing it signs everyone out.
BETTER_AUTH_SECRET=
# The admin site's own origin, a full URL (it is validated as one). Required. Not secret.
# Local: the port you serve the app on, e.g. `pnpm -C apps/admin dev -p 3101` (next dev alone uses
# 3000, which the booking app also wants). Deployed: the production origin. No default in the code.
BETTER_AUTH_URL=http://localhost:3101
# Comma-separated owner emails, matched case-insensitively. Required for any staff access. Not
# secret. No default: unset or empty means nobody is an owner. Must equal the API's and the
# gateway's ADMIN_EMAILS. Locally, use the Google account you sign in with.
ADMIN_EMAILS=

# --- Calls to the API (Cloud Run, IAM-gated) ----------------------------------------------------
# HMAC key that signs the assertion sent to the API's /internal endpoints. Required. Secret. At
# least 32 characters (the API refuses a shorter one, backend/app/core/config.py). Generate with
# `openssl rand -hex 32`. The same value must be set on the API, the gateway and the booking app.
INTERNAL_SIGNING_KEY=
# Base URL of the API. Required (empty gives a 503 API_NOT_CONFIGURED). Not secret in the code's
# eyes, though the Vercel project marks it Sensitive. Local default: the compose API.
API_URL=http://localhost:8080
# Audience of the ID token minted for the API. Optional, default clinic-api. Not secret. Only used
# when deployed on Vercel (VERCEL_ENV set); locally no token is minted. Set it explicitly: an empty
# value would not fall back to the default.
API_AUDIENCE=clinic-api
# Google Cloud project number, for the Vercel -> Google token exchange. Required when deployed,
# unused locally. Not a credential, but the Vercel project marks it Sensitive. Find it with
# `gcloud projects describe <project-id> --format='value(projectNumber)'`.
GCP_PROJECT_NUMBER=
# Service account the Vercel identity impersonates to mint the ID token. Required when deployed,
# unused locally. Marked Sensitive in Vercel. Format: name@project-id.iam.gserviceaccount.com.
GCP_SERVICE_ACCOUNT_EMAIL=
# Workload identity pool id. Optional, not secret (marked Sensitive in Vercel). Default vercel, the
# pool infra/terraform/wif_vercel.tf creates; empty also falls back to it. Unused locally.
GCP_WORKLOAD_IDENTITY_POOL_ID=vercel
# Workload identity pool provider id. Optional, not secret (marked Sensitive in Vercel). Default
# vercel (infra/terraform/wif_vercel.tf); empty also falls back to it. Unused locally.
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=vercel

# --- Live feed ---------------------------------------------------------------------------------
# Base URL of the realtime gateway behind /live/stream. Required for the live feed (empty means the
# feed is unavailable). Not secret. Local default: the compose gateway, started with
# `docker compose --profile realtime up` (host port 8090, REALTIME_HOST_PORT).
REALTIME_URL=http://localhost:8090
# Audience of the ID token minted for the gateway. Optional, default clinic-realtime. Not secret.
# Only used when deployed. Set it explicitly: an empty value would not fall back to the default.
REALTIME_AUDIENCE=clinic-realtime

# --- Staff email -------------------------------------------------------------------------------
# Resend API key for invite, staff notice and doctor arrival emails. Optional: unset means email is off, nothing is sent
# and one line is logged. Secret. Set it in the Vercel environment (the Resend dashboard issues
# it); leave it blank locally unless you want real mail.
RESEND_API_KEY=
# Base URL of the Resend API. Optional, default https://api.resend.com. Not secret. Only the e2e
# run changes it (to its stand-in). An empty value would not fall back to the default.
RESEND_BASE_URL=https://api.resend.com

# --- Set by the platform, never by hand --------------------------------------------------------
# NODE_ENV (Next.js), VERCEL and VERCEL_ENV (Vercel). The app reads them to tell production from
# preview and local runs (VERCEL_ENV set turns on the ID-token minting above); they are not listed
# as assignments on purpose.

# --- End-to-end runs only (apps/admin/e2e, playwright.config.ts, scripts/e2e_admin.sh) ----------
# None of these is secret. Leave them out of every deployed environment. `make e2e-admin` sets
# what it needs itself, so you rarely have to touch them.
# Set to 1 to build with the e2e-only error page that the shell specs open (next.config.ts). Default
# unset; a real build must not have it.
SHELL_E2E=
# API the e2e run points the app at. Default http://127.0.0.1:8080 (scripts/e2e_admin.sh). Commented
# out: playwright.config.ts reads it with `??`, so setting it, even to the default, pins it.
# E2E_API_URL=http://127.0.0.1:8080
# Gateway the e2e run points the app at. Default http://127.0.0.1:<REALTIME_HOST_PORT>, i.e. 8090
# (scripts/e2e_admin.sh). Commented out: setting it pins it and it stops following REALTIME_HOST_PORT.
# E2E_REALTIME_URL=http://127.0.0.1:8090
# Port the production build is served on during the run. Default 3101. Change it when 3101 is taken.
ADMIN_E2E_PORT=3101
# Port of the Resend stand-in the run starts; the app's email goes there. Default 3298.
ADMIN_E2E_RESEND_PORT=3298
# Compose project of the stack the run uses, so it never touches a dev stack's volumes. Optional,
# not secret. Empty here: scripts/e2e_admin.sh falls back to clinic-e2e, and a value here would
# also redirect every plain `docker compose` you run from a shell that sourced this file.
COMPOSE_PROJECT_NAME=
# The seeded appointments as JSON, written by e2e/global-setup.ts for the specs. Never set by hand.
E2E_STATE=
# Path to an installed Chrome for Playwright. Optional; unset uses the installed "chrome" channel.
PW_CHROME_PATH=
# Any non-empty value makes Playwright use its bundled Chromium instead. Optional, default unset.
PW_BUNDLED=
# CPU slow-down factor for the performance scenarios, to model a slow CI runner. Default 1 (off).
ADMIN_E2E_CPU_THROTTLE=1
# Same, for the fonts spec only. Default 1 (off).
FONTS_E2E_CPU_THROTTLE=1
