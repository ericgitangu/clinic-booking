# Every variable the web app reads, with no values. `make env-pull` fills web/.env.local (gitignored)
# from the Vercel project's Development environment, but Vercel never returns variables marked
# Sensitive: those are tagged "sensitive: copy manually" below and go into .env.local by hand.
# Never write a secret into this file.

# --- Proxy to the API (Cloud Run, IAM-gated) ---------------------------------------------------
# Base URL of the Cloud Run service the server side calls.
# sensitive: copy manually
API_URL=
# The custom audience Cloud Run accepts on the ID token.
# sensitive: copy manually
API_AUDIENCE=
# Google Cloud project number and the service account the Vercel identity impersonates.
# sensitive: copy manually
GCP_PROJECT_NUMBER=
# sensitive: copy manually
GCP_SERVICE_ACCOUNT_EMAIL=
# sensitive: copy manually
GCP_WORKLOAD_IDENTITY_POOL_ID=
# sensitive: copy manually
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=
# Requests per minute allowed per client at the proxy.
RATE_LIMIT_PER_MINUTE=

# --- Sign-in (Google, through Better Auth) ----------------------------------------------------
# OAuth client created in the sil-clinic-booking project.
# sensitive: copy manually
GOOGLE_CLIENT_ID=
# sensitive: copy manually
GOOGLE_CLIENT_SECRET=
# Signs and encrypts the session cookie. Generate with `openssl rand -base64 32`.
# sensitive: copy manually
BETTER_AUTH_SECRET=
# The site's own origin: http://localhost:3000 locally, https://clinic.ericgitangu.com in production.
BETTER_AUTH_URL=
# Signs the assertion the web app sends to the API's /internal endpoints.
# sensitive: copy manually
INTERNAL_SIGNING_KEY=

# --- Bot protection (reCAPTCHA through Google Cloud) -------------------------------------------
# Public site key; safe in the browser.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# The service account the server impersonates to create assessments (clinic-recaptcha@<project>).
# sensitive: copy manually
RECAPTCHA_SERVICE_ACCOUNT_EMAIL=
# Lowest score accepted. 0.5 if unset.
RECAPTCHA_MIN_SCORE=
# Off only when this is false AND E2E=1 (or NODE_ENV=test), for automated tests that have no Google
# identity. Production always checks, and a preview or local run without E2E=1 checks too, so it
# cannot book without real keys.
RECAPTCHA_ENFORCE=
E2E=

# --- Email and reminders -----------------------------------------------------------------------
# Resend API key. Vercel environment only.
# sensitive: copy manually
RESEND_API_KEY=
# Shared secret Vercel Cron sends so only it can call the reminders route.
# sensitive: copy manually
CRON_SECRET=
