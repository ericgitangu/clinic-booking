# Every variable the web app reads, with no values. `make env-pull` fills web/.env.local (gitignored)
# from the Vercel project's Development environment, but Vercel never returns variables marked
# Sensitive: those are tagged "sensitive: copy manually" below and go into .env.local by hand.
# Never write a secret into this file.

# --- Proxy to the API (Cloud Run, IAM-gated) ---------------------------------------------------
# Base URL of the Cloud Run service the server side calls.
# sensitive: copy manually
API_URL=
# The custom audience Cloud Run accepts on the ID token.
# sensitive: copy manually
API_AUDIENCE=
# Google Cloud project number and the service account the Vercel identity impersonates.
# sensitive: copy manually
GCP_PROJECT_NUMBER=
# sensitive: copy manually
GCP_SERVICE_ACCOUNT_EMAIL=
# sensitive: copy manually
GCP_WORKLOAD_IDENTITY_POOL_ID=
# sensitive: copy manually
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=
# Requests per minute allowed per client at the proxy. Not secret. Default 120.
RATE_LIMIT_PER_MINUTE=
# Base URL of the realtime gateway; the proxy sends /api/stream there (packages/api). Not secret.
REALTIME_URL=
# The custom audience the gateway accepts on the ID token. Not secret. Default clinic-realtime.
REALTIME_AUDIENCE=

# --- Sign-in (Google, through Better Auth) ----------------------------------------------------
# OAuth client created in the sil-clinic-booking project.
# sensitive: copy manually
GOOGLE_CLIENT_ID=
# sensitive: copy manually
GOOGLE_CLIENT_SECRET=
# Signs and encrypts the session cookie. Generate with `openssl rand -base64 32`.
# sensitive: copy manually
BETTER_AUTH_SECRET=
# The site's own origin: http://localhost:3000 locally, https://clinic.ericgitangu.com in production.
BETTER_AUTH_URL=
# Signs the assertion the web app sends to the API's /internal endpoints.
# sensitive: copy manually
INTERNAL_SIGNING_KEY=

# --- Bot protection (reCAPTCHA through Google Cloud) -------------------------------------------
# Public site key; safe in the browser.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# The service account the server impersonates to create assessments (clinic-recaptcha@<project>).
# sensitive: copy manually
RECAPTCHA_SERVICE_ACCOUNT_EMAIL=
# Lowest score accepted. 0.5 if unset.
RECAPTCHA_MIN_SCORE=
# Off only when this is false AND E2E=1 (or NODE_ENV=test), for automated tests that have no Google
# identity. Production always checks, and a preview or local run without E2E=1 checks too, so it
# cannot book without real keys.
RECAPTCHA_ENFORCE=
E2E=

# --- Email and reminders -----------------------------------------------------------------------
# Resend API key. Vercel environment only.
# sensitive: copy manually
RESEND_API_KEY=
# Shared secret Vercel Cron sends so only it can call the reminders route.
# sensitive: copy manually
CRON_SECRET=
# Base URL of the Resend API. Not secret. Default https://api.resend.com; only a test stand-in changes it.
RESEND_BASE_URL=

# --- Content-Security-Policy ------------------------------------------------------------------
# Extra connect-src origins, comma-separated. Not secret. Only for the local push stand-in
# (E2E_PUSH_LOCAL=1, http://localhost:<port>); the build refuses anything else.
CSP_EXTRA_CONNECT=

# --- Set by the platform, never by hand --------------------------------------------------------
# NODE_ENV (Next.js), VERCEL and VERCEL_ENV (Vercel). The app reads them to tell production from
# preview and local runs; they are not listed as assignments on purpose.

# --- End-to-end and test runs only (apps/booking/e2e, tests, playwright.config.ts) ---------------
# Not secret unless marked. Leave unset in every deployed environment.
# API the Playwright run points the app at. Default http://127.0.0.1:8080.
E2E_API_URL=
# API the two-instance and email-allowance tests call for real (make e2e sets it).
REAL_API_URL=
# Postgres URL and host port the e2e helpers use directly. E2E_DB_URL is secret (it holds a password).
E2E_DB_URL=
DB_HOST_PORT=
# Set to 1 to use the local push stand-in instead of Ably.
E2E_PUSH_LOCAL=
# Port and shared secret of the local push stand-in (secret, throwaway).
FAKE_PUSH_PORT=
FAKE_PUSH_SECRET=
# Port of the local email stand-in.
RESEND_STANDIN_PORT=
# Ably key for the live-update scenarios when the stand-in is not used. Secret.
ABLY_API_KEY=
# Set to 1 to run the reCAPTCHA script scenario against a build made with scripts/ci/public-build.env.
E2E_PUBLIC_BUILD=
# The site key that build was made with (public by design); the scenario compares it to the page.
E2E_EXPECT_SITE_KEY=
# Also checks external links in the e2e run.
E2E_CHECK_EXTERNAL=
# Set to 1 to build and serve the e2e-only error page and its route (the Makefile and
# playwright.config.ts set it). Never set in a deployed environment.
SHELL_E2E=
# Playwright browser: path to an installed Chrome, or a flag to use the bundled Chromium.
PW_CHROME_PATH=
PW_BUNDLED=
# CPU throttle factors for the performance scenarios.
PW_CPU_THROTTLE=
FONTS_E2E_CPU_THROTTLE=
# Directory the architecture-page screenshots are written to.
ARCH_SHOTS=
