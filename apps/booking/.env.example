# Every variable the booking web app reads (apps/booking and packages/api).
#
# Copy to apps/booking/.env.local (gitignored) for local work. `make env-pull` fills it from the
# Vercel project's Development environment, but Vercel never returns variables marked Sensitive;
# those are tagged "SECRET" or Sensitive below ("sensitive: copy manually") and you paste them in
# by hand. Anything that is a key, token,
# password or signing key is left empty here on purpose. Never write a secret into this file.
#
# Local stack: `make up` starts the API on http://localhost:8080 and Postgres on 5432. The realtime
# gateway is optional: `docker compose --profile realtime up` serves it on http://localhost:8090.
# Where a comment says "Default", that is what the code uses when the variable is unset. Several
# reads use ??, so an empty value is not the same as unset: lines that show a value keep it, and
# empty lines are secrets or switches whose empty value means off.
# Platform-set names (NODE_ENV, VERCEL, VERCEL_ENV) are not listed as assignments: see the end.

# --- Proxy to the API (Cloud Run, IAM-gated) ---------------------------------------------------
# Base URL of the API the server side calls. Required: without it every API call answers 503
# API_NOT_CONFIGURED. Not a secret locally. Default none; locally the compose API is below.
# In Vercel it is the Cloud Run service URL and is marked Sensitive.
API_URL=http://localhost:8080
# Audience the API accepts on the Google ID token. Only used when the app runs on Vercel (locally no
# token is minted). Optional. Default clinic-api. Not a secret.
API_AUDIENCE=clinic-api
# Google Cloud project NUMBER (digits, not the project id) used to exchange the Vercel OIDC token.
# Required on Vercel only; unused locally. Default none. Sensitive in Vercel: SECRET, leave empty here.
GCP_PROJECT_NUMBER=
# Service account the Vercel identity impersonates to mint the ID token for the API.
# Required on Vercel only; unused locally. Default none. Sensitive in Vercel: SECRET, leave empty here.
GCP_SERVICE_ACCOUNT_EMAIL=
# Workload identity pool id. Optional, Vercel only, not secret (Vercel marks it Sensitive). Default
# vercel, the pool infra/terraform/wif_vercel.tf creates; empty also falls back to it.
GCP_WORKLOAD_IDENTITY_POOL_ID=vercel
# Workload identity pool provider id. Optional, Vercel only, not secret (Vercel marks it Sensitive).
# Default vercel (infra/terraform/wif_vercel.tf); empty also falls back to it.
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=vercel
# Requests per minute allowed per client address at the /api proxy. Optional. Default 120
# (a non-numeric or zero value falls back to 120). Not a secret.
RATE_LIMIT_PER_MINUTE=120
# Base URL of the realtime gateway; the proxy sends /api/stream there. Optional: without it live
# updates are unavailable and the page polls. Not a secret. Default none; locally the compose
# gateway (profile "realtime") is below.
REALTIME_URL=http://localhost:8090
# Audience the gateway accepts on the Google ID token (Vercel only). Optional. Default
# clinic-realtime. Not a secret.
REALTIME_AUDIENCE=clinic-realtime

# --- Sign-in (Google, through Better Auth) ----------------------------------------------------
# Sign-in needs all four of these (BETTER_AUTH_URL, BETTER_AUTH_SECRET, GOOGLE_CLIENT_ID,
# GOOGLE_CLIENT_SECRET). If any is missing, /auth, /appointments and the details step answer a 503
# page and log which names are missing. Read per request, never at build.
# Google OAuth client id, from the OAuth client in the sil-clinic-booking Google Cloud project
# (APIs & Services > Credentials). Required. Default none. Treated as SECRET: paste by hand.
GOOGLE_CLIENT_ID=
# Google OAuth client secret from the same client. Required. Default none. SECRET.
GOOGLE_CLIENT_SECRET=
# Signs and encrypts the session cookie. Required. Default none. SECRET. Generate your own with
# `openssl rand -base64 32` (packages/api/src/auth-env.ts only checks it is not empty).
BETTER_AUTH_SECRET=
# The site's own origin, a full URL. Required. Not a secret. Default none; locally
# http://localhost:3000, production https://clinic.ericgitangu.com. The Google client's redirect
# URI must be <this value>/auth/callback/google.
BETTER_AUTH_URL=http://localhost:3000
# Signs the assertion the app sends to the API's /internal endpoints. Required for any signed-in
# call: without it those calls answer 503 SIGNING_KEY_NOT_SET. Default none. SECRET. Must be the
# same value the API runs with and at least 32 characters. Generate with `openssl rand -hex 32`;
# the API (docker compose) reads it from your shell, so export the same value before `make up`.
INTERNAL_SIGNING_KEY=

# --- Bot protection (reCAPTCHA Enterprise through Google Cloud) --------------------------------
# Public reCAPTCHA site key. Required to book when the check is enforced; inlined into the browser
# bundle at BUILD time, so set it before `pnpm build`. Public by design, but left empty here
# like every key: the value CI builds with is in scripts/ci/public-build.env. Default none.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# Service account the server impersonates to create reCAPTCHA assessments (clinic-recaptcha@<project>).
# Required when the check is enforced; Vercel only. Default none. Sensitive in Vercel: SECRET.
RECAPTCHA_SERVICE_ACCOUNT_EMAIL=
# Lowest score accepted, a number above 0. Optional. Default 0.5. Not a secret.
RECAPTCHA_MIN_SCORE=0.5
# Turns the human check off, for local work and automated tests only. It is honoured only when
# this is "false" AND the run is a test run: not Vercel production, E2E=1 (or NODE_ENV=test), and
# BETTER_AUTH_URL on localhost. Anywhere else the check always runs and, with no keys, booking is
# refused. Optional, not secret. Default: enforced (empty or anything but "false"). To book
# locally without reCAPTCHA keys, set this to false and E2E=1 below.
RECAPTCHA_ENFORCE=
# Marks a local or automated run as a test run (see RECAPTCHA_ENFORCE). Besides the human check it
# lifts the sign-in rate limit to 100000 per 10 s and adds render-count attributes to the grid.
# Optional, not secret. Default unset (not a test run); only the exact value 1 counts. Set it to 1
# together with RECAPTCHA_ENFORCE=false for local booking without keys; never in a deployed environment.
E2E=

# --- Email and reminders -----------------------------------------------------------------------
# Resend API key. Optional: without it no email is sent and a single warning is logged. Default
# none. SECRET: Vercel environment only, leave empty for local work.
RESEND_API_KEY=
# Shared secret Vercel Cron sends as a bearer token so only it can call /cron/reminders. Required
# for that route (it answers 401 if unset or shorter than 16 characters). Default none. SECRET.
# Generate with `openssl rand -hex 32`.
CRON_SECRET=
# Base URL of the Resend API. Optional. Default https://api.resend.com. Not a secret; only a test
# stand-in changes it.
RESEND_BASE_URL=https://api.resend.com

# --- Content-Security-Policy ------------------------------------------------------------------
# Extra connect-src origins, comma-separated. Optional. Default none. Not a secret. Only for the
# local push stand-in: needs E2E_PUSH_LOCAL=1 and an http://localhost:<port> origin (for example
# http://localhost:3199); the build refuses anything else. Leave empty otherwise.
CSP_EXTRA_CONNECT=

# --- Set by the platform, never by hand --------------------------------------------------------
# NODE_ENV (Next.js), VERCEL and VERCEL_ENV (Vercel). The app reads them to tell production from
# preview and local runs; they are not listed as assignments on purpose.

# --- End-to-end and test runs only (apps/booking/e2e, tests, playwright.config.ts) ---------------
# `make e2e` sets most of these itself. Leave all of them unset in every deployed environment.
# API the Playwright run points the app at. Optional. Default http://127.0.0.1:8080 (`make e2e` sets
# its own, on E2E_API_PORT). Not a secret. Commented out because playwright.config.ts reads it with
# `??`: setting it, even to the default, pins it. Uncomment only to use a different API.
# E2E_API_URL=http://127.0.0.1:8080
# Opt-in switch for the tests that call a real API (two-instance, email-allowance). Unset: they are
# skipped. Set: they run and need a running stack at that URL, and fail without one. `make e2e` sets
# it to its own API port (18080). Not a secret. Commented out so that sourcing this file does not
# switch them on; the value shown is for a plain `make up` stack.
# REAL_API_URL=http://127.0.0.1:8080
# Postgres URL the e2e helpers use directly. Optional. Default is the compose database on
# 127.0.0.1 at DB_HOST_PORT (its login is in docker-compose.yml). SECRET in general because a URL
# holds a password, so empty. Commented out: the helpers read it with `??`, an empty value is used
# as is, and setting it pins the database instead of following DB_HOST_PORT.
# E2E_DB_URL=
# Host port of the compose Postgres, shared with the Makefile. Optional. Default 5432. Not a secret.
DB_HOST_PORT=5432
# Set to 1 to run the live-update scenarios against the local push stand-in instead of Ably.
# Optional. Default unset (off). Not a secret.
E2E_PUSH_LOCAL=
# Port of the local push stand-in. Optional. Default 3199. Not a secret.
FAKE_PUSH_PORT=3199
# Shared secret of the local push stand-in (e2e/support/fake-push.mjs). Optional; it has a
# throwaway built-in default. SECRET in form, so empty here. The stand-in reads it with ??, so an
# exported empty value is used as is: delete the line rather than export it empty.
FAKE_PUSH_SECRET=
# Port of the local email stand-in (the Resend look-alike). Optional. Default 3198. Not a secret.
RESEND_STANDIN_PORT=3198
# Ably API key for the live-update scenarios when the local stand-in is not used. Optional;
# without it and without E2E_PUSH_LOCAL those scenarios are skipped. Default none. SECRET.
ABLY_API_KEY=
# Set to 1 to run the reCAPTCHA script scenario, which needs a build made with
# scripts/ci/public-build.env. Optional. Default unset (scenario skipped). Not a secret.
E2E_PUBLIC_BUILD=
# The site key that build was made with; the scenario compares it with the page. Required when
# E2E_PUBLIC_BUILD is set. Public by design, left empty here; take it from scripts/ci/public-build.env.
E2E_EXPECT_SITE_KEY=
# Set to 1 to also check external links in the e2e run. Optional. Default unset (not checked).
E2E_CHECK_EXTERNAL=
# Set to 1 to build and serve the e2e-only error page and its route. The Makefile and
# playwright.config.ts set it. Optional. Default unset. Never set in a deployed environment.
SHELL_E2E=
# Playwright browser: path to an installed Chrome. Optional. Default none (the installed Chrome
# channel is used). Not a secret.
PW_CHROME_PATH=
# Set to 1 to use Playwright's bundled Chromium instead of installed Chrome (CI does). Optional.
# Default unset. Not a secret.
PW_BUNDLED=
# CPU throttle factor for the performance scenarios (1 = none, 4 = four times slower). Optional.
# Default 1. Not a secret.
PW_CPU_THROTTLE=1
# CPU throttle factor for the font-loading scenario. Optional. Default 1. Not a secret.
FONTS_E2E_CPU_THROTTLE=1
# Directory the architecture-page screenshots are written to. Optional. Default unset (no
# screenshots taken). Not a secret.
ARCH_SHOTS=
