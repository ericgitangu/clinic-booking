  "info": {
    "title": "Clinic Booking API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/appointments": {
      "post": {
        "operationId": "create_appointment_appointments_post",
        "parameters": [
          {
            "description": "Chosen by the client once per booking attempt and reused on a retry. The same key with the same doctor and time returns the original booking with `Idempotent-Replayed: true`; with a different doctor or time it is IDEMPOTENCY_KEY_REUSED; once the booking is cancelled it is IDEMPOTENCY_KEY_CONSUMED.",
            "in": "header",
            "name": "Idempotency-Key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 255,
                  "minLength": 1,
                  "pattern": "^[\\x21-\\x7e]{1,255}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Chosen by the client once per booking attempt and reused on a retry. The same key with the same doctor and time returns the original booking with `Idempotent-Replayed: true`; with a different doctor or time it is IDEMPOTENCY_KEY_REUSED; once the booking is cancelled it is IDEMPOTENCY_KEY_CONSUMED.",
              "title": "Idempotency-Key"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AppointmentCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Appointment"
                }
              }
            },
            "description": "Created, or the earlier booking replayed for the same Idempotency-Key",
            "headers": {
              "Idempotent-Replayed": {
                "description": "`true` when this response replays an earlier booking.",
                "schema": {
                  "enum": ["true"],
                  "type": "string"
                }
              }
            }
          },
          "409": {
            "content": {
              "application/problem+json": {}
            },
            "description": "Problem (RFC 9457)"
          },
          "422": {
            "content": {
              "application/problem+json": {}
            },
            "description": "Problem (RFC 9457)"
          },
          "503": {
            "content": {
              "application/problem+json": {}
            },
            "description": "Problem (RFC 9457)"
          }
        },
        "summary": "Create Appointment",
        "tags": ["appointments"]
      }
    },
