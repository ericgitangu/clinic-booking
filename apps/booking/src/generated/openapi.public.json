  "info": {
    "title": "Idyllic Clinic API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/appointments": {
      "post": {
        "description": "Refused with 422 BOOKING_TOO_SOON when the appointment begins less than 60 minutes from now (BOOKING_MIN_LEAD_MINUTES).",
        "operationId": "create_appointment_appointments_post",
        "parameters": [
          {
            "description": "Chosen by the client once per booking attempt and reused on a retry. The same key with the same doctor and time returns the original booking with `Idempotent-Replayed: true`; with a different doctor or time it is IDEMPOTENCY_KEY_REUSED; once the booking is cancelled it is IDEMPOTENCY_KEY_CONSUMED.",
            "in": "header",
            "name": "Idempotency-Key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 255,
                  "minLength": 1,
                  "pattern": "^[\\x21-\\x7e]{1,255}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Chosen by the client once per booking attempt and reused on a retry. The same key with the same doctor and time returns the original booking with `Idempotent-Replayed: true`; with a different doctor or time it is IDEMPOTENCY_KEY_REUSED; once the booking is cancelled it is IDEMPOTENCY_KEY_CONSUMED.",
              "title": "Idempotency-Key"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AppointmentCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Appointment"
                }
              }
            },
            "description": "Created, or the earlier booking replayed for the same Idempotency-Key",
            "headers": {
              "Idempotent-Replayed": {
                "description": "`true` when this response replays an earlier booking.",
                "schema": {
                  "enum": ["true"],
                  "type": "string"
                }
              }
            }
          },
          "409": {
            "content": {
              "application/problem+json": {}
            },
            "description": "Problem (RFC 9457)"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "examples": {
                  "BOOKING_TOO_SOON": {
                    "summary": "BOOKING_TOO_SOON",
                    "value": {
                      "code": "BOOKING_TOO_SOON",
                      "detail": "A booking, or a reschedule's new time, starts less than the minimum lead time (BOOKING_MIN_LEAD_MINUTES, 60 by default) ahead of now.",
                      "errors": null,
                      "instance": "/appointments",
                      "request_id": "00000000-0000-4000-8000-000000000000",
                      "status": 422,
                      "title": "Booking too soon",
                      "type": "https://api.example/problems/booking-too-soon"
                    }
                  }
                }
              }
            },
            "description": "Problem (RFC 9457), including BOOKING_TOO_SOON"
          },
          "503": {
            "content": {
              "application/problem+json": {}
            },
            "description": "Problem (RFC 9457)"
          }
        },
        "summary": "Create Appointment",
        "tags": ["appointments"]
      }
    },
    "/appointments/{appointment_id}": {
      "get": {
        "operationId": "get_appointment_appointments__appointment_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "appointment_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Appointment Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Appointment"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/problem+json": {}
            },
            "description": "Problem (RFC 9457)"
          },
          "422": {
            "content": {
              "application/problem+json": {}
            },
            "description": "Problem (RFC 9457)"
          }
        },
        "summary": "Get Appointment",
        "tags": ["appointments"]
      }
    },
    "/appointments/{appointment_id}/cancel": {
      "patch": {
        "description": "Refused with 409 CHANGE_TOO_LATE when the appointment begins less than 60 minutes from now (BOOKING_MIN_LEAD_MINUTES).",
        "operationId": "cancel_appointment_appointments__appointment_id__cancel_patch",
        "parameters": [
          {
            "in": "path",
            "name": "appointment_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Appointment Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CancelRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Appointment"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/problem+json": {}
            },
            "description": "Problem (RFC 9457)"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "examples": {
                  "CHANGE_TOO_LATE": {
                    "summary": "CHANGE_TOO_LATE",
                    "value": {
                      "code": "CHANGE_TOO_LATE",
                      "detail": "Changing or cancelling a visit that starts less than the minimum lead time (BOOKING_MIN_LEAD_MINUTES, 60 by default) from now. A reschedule's new time is BOOKING_TOO_SOON instead.",
                      "errors": null,
                      "instance": "/appointments/{appointment_id}/cancel",
                      "request_id": "00000000-0000-4000-8000-000000000000",
                      "status": 409,
                      "title": "Change too late",
                      "type": "https://api.example/problems/change-too-late"
                    }
                  }
                }
              }
            },
            "description": "Problem (RFC 9457), including CHANGE_TOO_LATE"
          },
          "422": {
            "content": {
              "application/problem+json": {}
            },
            "description": "Problem (RFC 9457)"
          }
        },
        "summary": "Cancel Appointment",
        "tags": ["appointments"]
      }
    },
    "/appointments/{appointment_id}/reschedule": {
      "patch": {
        "description": "Refused with 409 CHANGE_TOO_LATE when the appointment's current start begins less than 60 minutes from now (BOOKING_MIN_LEAD_MINUTES), and with 422 BOOKING_TOO_SOON when the new start does, exactly as for a fresh booking. Repeating a reschedule that already happened (same new start) returns the appointment.",
        "operationId": "reschedule_appointment_appointments__appointment_id__reschedule_patch",
        "parameters": [
          {
            "in": "path",
            "name": "appointment_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Appointment Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RescheduleRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Appointment"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/problem+json": {}
            },
            "description": "Problem (RFC 9457)"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "examples": {
                  "CHANGE_TOO_LATE": {
                    "summary": "CHANGE_TOO_LATE",
                    "value": {
                      "code": "CHANGE_TOO_LATE",
                      "detail": "Changing or cancelling a visit that starts less than the minimum lead time (BOOKING_MIN_LEAD_MINUTES, 60 by default) from now. A reschedule's new time is BOOKING_TOO_SOON instead.",
