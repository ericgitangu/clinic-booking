      "Availability": {
        "properties": {
          "cursor": {
            "description": "\"<txid>.<id>\" read before the slots, in the same moment: every pushed event at or before it is already reflected in `slots`. Accept a newer response only if its cursor is not older than the one you hold.",
            "pattern": "^(0|[1-9][0-9]{0,19})\\.(0|[1-9][0-9]{0,19})$",
            "title": "Cursor",
            "type": "string"
          },
          "date": {
            "title": "Date",
            "type": "string"
          },
          "doctor_id": {
            "format": "uuid",
            "title": "Doctor Id",
            "type": "string"
          },
          "slot_minutes": {
            "const": 30,
            "default": 30,
            "title": "Slot Minutes",
            "type": "integer"
