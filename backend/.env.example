# Settings for the FastAPI API. The source of truth is backend/app/core/config.py
# (pydantic-settings); variable names are the field names, with no prefix.
#
# How values reach the API:
#   - Local: docker-compose.yml passes them to the `api` service (`make up`). The API does not read
#     a .env file itself (env_file=None), so export a value in your shell or set it for compose.
#   - Cloud Run: secrets come from Secret Manager (--set-secrets), the rest from --set-env-vars.
#
# Value rules:
#   - Secrets are left empty here. Never write a real secret into this file.
#   - Everything else shows the local default the code or compose uses, so you can copy the file as is.
#   - A variable set to an empty string is NOT the same as unset: a numeric setting left empty fails
#     at start-up, and a test setting left empty overrides its default. Delete a line you do not
#     want to set instead of blanking it.
#
# Each comment: what it does, required or optional, default, secret or not.

# --- Database ---------------------------------------------------------------------------------
# Postgres connection URL for the API's runtime role. Required, no default. SECRET (it carries a
# password), so empty here. Must start with postgresql+asyncpg://, and must not set sslmode or
# channel_binding (asyncpg rejects them; use ?ssl=require for a hosted database). Format:
# postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DB. Locally docker-compose.yml sets it for the api
# service (the clinic_app role, SELECT/INSERT/UPDATE only), so `make up` needs nothing here; set it
# only to run the API outside compose. In production it is the Secret Manager secret
# clinic-database-url-app, and the migrate job gets the owner role's URL under the same name
# (secret clinic-database-url-migrate, read by backend/migrations/env.py).
DATABASE_URL=
# Connections kept open in the SQLAlchemy pool. Optional, not secret. Default 5.
DB_POOL_SIZE=5

# --- Booking rules ----------------------------------------------------------------------------
# Shortest notice for a booking, in minutes. Optional, not secret. Default 60.
BOOKING_MIN_LEAD_MINUTES=60
# How far ahead a booking may be made, in days. Optional, not secret. Default 90.
BOOKING_HORIZON_DAYS=90
# IANA time zone for timestamps that belong to no clinic (a patient's created_at, staff access
# granted/revoked times). Optional, not secret. Default Africa/Nairobi; an unknown zone fails start-up.
DEFAULT_CLINIC_TZ=Africa/Nairobi

# --- Email allowances (Resend free plan: 100 a day, 3,000 a month) ----------------------------
# Emails a day, shared by acknowledgements and reminders. Optional, not secret. Default 100.
# Must be at least EMAIL_ACK_RESERVE. docker-compose.yml passes it through (${EMAIL_DAILY_LIMIT:-100}).
EMAIL_DAILY_LIMIT=100
# Emails a calendar month (UTC). Optional, not secret. Default 3000.
EMAIL_MONTHLY_LIMIT=3000
# Most reminders one run may claim; a run never claims more than what is left of the day. Optional,
# not secret. Default 50.
REMINDER_RUN_LIMIT=50
# Part of the daily allowance kept free of reminders and other emails, so acknowledgements always
# fit. Optional, not secret. Default 20. Cannot be negative or above EMAIL_DAILY_LIMIT.
EMAIL_ACK_RESERVE=20
# Minutes a claimed reminder is held before another run may retry it. Optional, not secret. Default 15.
REMINDER_LEASE_MINUTES=15

# --- Service ----------------------------------------------------------------------------------
# Port uvicorn listens on (read by backend/Dockerfile, not by Settings; Cloud Run sets it).
# Optional, not secret. Default 8080. docker-compose.yml fixes it to 8080 inside the container and
# publishes it on the host as ${API_HOST_PORT:-8080}.
PORT=8080
# The one origin CORS allows, and the site that may ask for live-update tokens. Optional, not
# secret. Default http://localhost:3000 (the booking app's local dev server). Set it to the
# deployed site's origin in production.
WEB_ORIGIN=http://localhost:3000
# The API's own public base URL. Optional, not secret. Default http://localhost:8080.
PUBLIC_BASE_URL=http://localhost:8080
# Log level. Optional, not secret. Default info.
LOG_LEVEL=info
# Commit the running build was made from; the deploy sets it. Optional, not secret. Default unknown.
GIT_SHA=unknown

# --- Identity ---------------------------------------------------------------------------------
# HMAC key shared with the booking app, the admin app and the realtime gateway; it verifies the
# signed assertions on /internal/*. SECRET, so empty here. Optional locally, but unset (or empty)
# closes every /internal/* route, so set it to use the web apps. Must be 32+ characters. Generate
# one with: openssl rand -hex 32. Production: Vercel project env for the web apps and the
# Secret Manager secret clinic-internal-signing-key for Cloud Run; all consumers hold the same value.
INTERNAL_SIGNING_KEY=
# Second HMAC key, held only by the release smoke test; it signs the one synthetic-patient call
# (/internal/smoke/patients) and nothing else. SECRET, so empty here. Optional. Must be 32+
# characters and must differ from INTERNAL_SIGNING_KEY. Generate one with: openssl rand -hex 32.
# Unset (or empty) refuses that call. Production: Secret Manager secret clinic-smoke-signing-key.
SMOKE_SIGNING_KEY=
# Comma-separated owner emails for the admin app. Optional, not secret, default empty (no owner).
# Owners need no staff_access row and cannot be changed through the API. Set it to your own email
# to sign in to the admin app locally. Must be the same value as the admin app's and the realtime
# gateway's ADMIN_EMAILS.
ADMIN_EMAILS=

# --- Staff writes -----------------------------------------------------------------------------
# Rollback switch for staff CRUD; false turns those routes off (404). Optional, not secret. Default true.
STAFF_CRUD_ENABLED=true
# Staff writes allowed per person in each window, whether or not they succeed. Optional, not
# secret. Default 60.
STAFF_WRITE_LIMIT=60
# Length of that window, in seconds. Optional, not secret. Default 600.
STAFF_WRITE_WINDOW_SECONDS=600

# --- Live updates (Ably); an empty ABLY_API_KEY means push is off and clients poll ------------
# Ably API key. SECRET, so empty here, and never logged. Optional: empty is a normal state and
# the apps fall back to polling. To try live updates, create your own Ably app and paste its key
# in your shell, not here. Production: Secret Manager secret clinic-ably-api-key (infra/terraform/ably.tf).
ABLY_API_KEY=
# Ably REST endpoint. Optional, not secret. Default https://main.realtime.ably.net.
ABLY_REST_URL=https://main.realtime.ably.net
# Ably event-stream endpoint. Optional, not secret. Default https://main.realtime.ably.net/event-stream.
ABLY_STREAM_URL=https://main.realtime.ably.net/event-stream
# Publishes allowed a month. Optional, not secret. Default 25000, which is also the ceiling:
# a larger value fails start-up (the free-plan arithmetic is in app/core/config.py). Range 0-25000.
REALTIME_PUBLISH_CAP_PER_MONTH=25000
# Seconds a write waits on the push relay before moving on. Optional, not secret. Default 2.0.
REALTIME_RELAY_TIMEOUT_SECONDS=2.0
# Events older than this many seconds are not pushed (the clients' poll covers them). Optional,
# not secret. Default 600.
REALTIME_MAX_EVENT_AGE_SECONDS=600
# Live-update tokens one client may fetch a minute. Optional, not secret. Default 10.
REALTIME_TOKEN_PER_MINUTE=10
# Live-update tokens issued a day, across all clients. Optional, not secret. Default 500.
REALTIME_TOKEN_DAILY_CAP=500

# --- Tests only (backend/tests/conftest.py, read by `make test`; the API ignores these) ------
# Test database host. Optional, not secret. Default localhost.
TEST_DB_HOST=localhost
# Test database port. Optional, not secret. Default 5432; the Makefile sets it from DB_HOST_PORT so
# `DB_HOST_PORT=5433 make up test` keeps the pair in step. Do not set a different value here.
TEST_DB_PORT=5432
# Test database name. Optional, not secret. Default clinic.
TEST_DB_NAME=clinic
# Owner role the tests migrate and seed with. Optional, not secret. Default clinic (the role
# docker-compose.yml creates).
TEST_OWNER_USER=clinic
# Password for that owner role. Secret by rule, so empty here. Delete this line to use the local
# default, which is the throwaway value in docker-compose.yml (POSTGRES_PASSWORD). Set it only
# when testing against a database whose owner password differs.
TEST_OWNER_PASSWORD=
# Runtime role the tests connect as. Optional, not secret. Default clinic_app
# (created by backend/docker/initdb/01-roles.sql).
TEST_APP_USER=clinic_app
# Password for that runtime role. Secret by rule, so empty here. Delete this line to use the local
# default, the throwaway value in backend/docker/initdb/01-roles.sql. Set it only for a database
# whose runtime-role password differs.
TEST_APP_PASSWORD=
# Fixed "now" the test clock uses, as an ISO 8601 timestamp with offset. Optional, not secret.
# The value here is the suite's own default (Monday 07:00 Nairobi). Set it to the database's time
# only to check one test against real time, not the whole suite (see conftest.py).
TEST_FIXED_NOW=2026-10-19T04:00:00+00:00
