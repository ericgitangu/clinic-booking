# Every variable the API (backend/app/core/config.py, pydantic-settings) and its migrations read.
# Names only, no values. Variable names are the field names: there is no prefix. Cloud Run gets the
# secrets from Secret Manager (--set-secrets) and the rest from --set-env-vars; locally,
# docker-compose.yml passes them. Never write a secret into this file.

# --- Database ---------------------------------------------------------------------------------
# asyncpg URL (postgresql+asyncpg://...). Secret. Required. A validator rejects sslmode and
# channel_binding; use ?ssl=require. The runtime role is SELECT/INSERT/UPDATE only. Alembic
# (migrations/env.py) reads the same name, but the migrate job gets the owner role's URL.
DATABASE_URL=
# Connections kept in the pool. Not secret. Default 5.
DB_POOL_SIZE=

# --- Booking rules ----------------------------------------------------------------------------
# Shortest notice for a booking, in minutes. Not secret. Default 60.
BOOKING_MIN_LEAD_MINUTES=
# How far ahead a booking may be made, in days. Not secret. Default 90.
BOOKING_HORIZON_DAYS=
# IANA zone for timestamps that belong to no clinic. Not secret. Default Africa/Nairobi.
DEFAULT_CLINIC_TZ=

# --- Email allowances (Resend free plan) ------------------------------------------------------
# Emails a day, shared by acknowledgements, reminders, staff emails and the doctor's arrival email.
# Not secret. Default 100.
EMAIL_DAILY_LIMIT=
# Emails a calendar month (UTC). Not secret. Default 3000.
EMAIL_MONTHLY_LIMIT=
# Most reminders one run may claim. Not secret. Default 50.
REMINDER_RUN_LIMIT=
# Daily allowance kept back from every other email so acknowledgements always fit. Not secret. Default 20.
EMAIL_ACK_RESERVE=
# Minutes a claimed reminder is leased before another run may retry it. Not secret. Default 15.
REMINDER_LEASE_MINUTES=

# --- Service ----------------------------------------------------------------------------------
# Port uvicorn listens on (backend/Dockerfile; Cloud Run sets it). Not secret. Default 8080.
PORT=
# The one origin CORS allows and the site that may ask for live-update tokens. Not secret.
# Default http://localhost:3000.
WEB_ORIGIN=
# The API's own public base URL. Not secret. Default http://localhost:8080.
PUBLIC_BASE_URL=
# Log level. Not secret. Default info.
LOG_LEVEL=
# Commit the build was made from, set by the deploy. Not secret. Default unknown.
GIT_SHA=

# --- Identity ---------------------------------------------------------------------------------
# HMAC key shared with both web apps and the realtime gateway; verifies /internal/* assertions.
# Secret, 32+ characters. Unset closes every /internal/* route.
INTERNAL_SIGNING_KEY=
# Second HMAC key held only by the release smoke test; signs the one synthetic-patient call.
# Secret, 32+ characters, must differ from INTERNAL_SIGNING_KEY. Unset refuses that call.
SMOKE_SIGNING_KEY=
# Comma-separated owner emails. Not secret. Must equal the admin app's and the gateway's value.
ADMIN_EMAILS=

# --- Staff writes -----------------------------------------------------------------------------
# Rollback switch for staff CRUD (false answers 404 on those routes). Not secret. Default true.
STAFF_CRUD_ENABLED=
# Staff writes allowed per person in each window. Not secret. Default 60.
STAFF_WRITE_LIMIT=
# Length of that window, in seconds. Not secret. Default 600.
STAFF_WRITE_WINDOW_SECONDS=

# --- Push service (Ably); unset ABLY_API_KEY means push off and clients poll ---------------------
# Ably API key. Secret. Never logged.
ABLY_API_KEY=
# Ably REST endpoint. Not secret. Default https://main.realtime.ably.net.
ABLY_REST_URL=
# Ably event-stream endpoint. Not secret. Default https://main.realtime.ably.net/event-stream.
ABLY_STREAM_URL=
# Publishes a month; start-up refuses a value above 25000. Not secret. Default 25000.
REALTIME_PUBLISH_CAP_PER_MONTH=
# Seconds a write waits on the push relay. Not secret. Default 2.0.
REALTIME_RELAY_TIMEOUT_SECONDS=
# Events older than this many seconds are not pushed. Not secret. Default 600.
REALTIME_MAX_EVENT_AGE_SECONDS=
# Live-update tokens one client may fetch a minute. Not secret. Default 10.
REALTIME_TOKEN_PER_MINUTE=
# Live-update tokens issued a day, all clients. Not secret. Default 500.
REALTIME_TOKEN_DAILY_CAP=

# --- Tests only (backend/tests/conftest.py); each has a local default -------------------------
# Test database host, port and name. Not secret. Defaults localhost, 5432, clinic.
TEST_DB_HOST=
TEST_DB_PORT=
TEST_DB_NAME=
# Test database owner role and its password. Secret (a local throwaway). Defaults clinic / clinic.
TEST_OWNER_USER=
TEST_OWNER_PASSWORD=
# Test database runtime role and its password. Secret (a local throwaway).
TEST_APP_USER=
TEST_APP_PASSWORD=
# ISO timestamp that replaces the suite's fixed clock, to check a test against real time. Not secret.
TEST_FIXED_NOW=
