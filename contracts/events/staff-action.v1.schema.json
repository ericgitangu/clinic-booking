{
  "$id": "https://clinic.example/contracts/events/staff-action.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The same staff action for an owner or admin: who did it, why, the patient (for a reminder\nor \"running late\") and the invited address and role (for an invitation).",
  "properties": {
    "actor_email": {
      "title": "Actor Email",
      "type": "string"
    },
    "actor_role": {
      "enum": [
        "owner",
        "admin",
        "viewer"
      ],
      "title": "Actor Role",
      "type": "string"
    },
    "appointment_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Appointment Id"
    },
    "delay_minutes": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Delay Minutes"
    },
    "doctor_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Doctor Id"
    },
    "invite_email": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Invite Email"
    },
    "invite_role": {
      "anyOf": [
        {
          "enum": [
            "admin",
            "viewer"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Invite Role"
    },
    "kind": {
      "enum": [
        "reminder_now",
        "running_late",
        "invite_created",
        "invite_revoked",
        "invite_accepted",
        "pass_created",
        "pass_revoked",
        "pass_accepted"
      ],
      "title": "Kind",
      "type": "string"
    },
    "patient_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Patient Name"
    },
    "reason": {
      "title": "Reason",
      "type": "string"
    },
    "seq": {
      "description": "\"<txid>.<id>\" of the event.",
      "pattern": "^(0|[1-9][0-9]{0,19})\\.(0|[1-9][0-9]{0,19})$",
      "title": "Seq",
      "type": "string"
    },
    "starts_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Starts At"
    }
  },
  "required": [
    "kind",
    "doctor_id",
    "starts_at",
    "delay_minutes",
    "seq",
    "appointment_id",
    "patient_name",
    "actor_email",
    "actor_role",
    "reason",
    "invite_email",
    "invite_role"
  ],
  "title": "StaffActionEvent",
  "type": "object"
}
