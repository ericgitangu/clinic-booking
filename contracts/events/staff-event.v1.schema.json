{
  "$id": "https://clinic.example/contracts/events/staff-event.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The same event for an owner or admin on the live feed: it adds the appointment (to link to\nit), the patient's name and, for a cancellation, the reason. Only the Go gateway\n(``services/realtime``) sends it, over the admin app's IAM-protected stream; it never travels\nthrough the push service. A viewer gets ``AdminEvent`` instead.",
  "properties": {
    "appointment_id": {
      "format": "uuid",
      "title": "Appointment Id",
      "type": "string"
    },
    "cancellation_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Cancellation Reason"
    },
    "doctor_id": {
      "format": "uuid",
      "title": "Doctor Id",
      "type": "string"
    },
    "event_type": {
      "enum": [
        "booked",
        "rescheduled",
        "cancelled",
        "vetoed",
        "unlocked",
        "arrived",
        "no_show"
      ],
      "title": "Event Type",
      "type": "string"
    },
    "from_local_date": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "From Local Date"
    },
    "from_starts_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "From Starts At"
    },
    "local_date": {
      "format": "date",
      "title": "Local Date",
      "type": "string"
    },
    "patient_name": {
      "title": "Patient Name",
      "type": "string"
    },
    "seq": {
      "description": "\"<txid>.<id>\" of the event.",
      "pattern": "^(0|[1-9][0-9]{0,19})\\.(0|[1-9][0-9]{0,19})$",
      "title": "Seq",
      "type": "string"
    },
    "to_starts_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "To Starts At"
    }
  },
  "required": [
    "event_type",
    "doctor_id",
    "local_date",
    "from_local_date",
    "from_starts_at",
    "to_starts_at",
    "seq",
    "appointment_id",
    "patient_name",
    "cancellation_reason"
  ],
  "title": "StaffEvent",
  "type": "object"
}
