{
  "name": "clinic-booking",
  "version": "1.0.0",
  "private": true,
  "description": "Clinic booking monorepo root: git hygiene tooling only.",
  "scripts": {
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10"
  },
  "lint-staged": {
    "backend/**/*.py": [
      "uv run --project backend ruff check --fix",
      "uv run --project backend ruff format"
    ],
    "web/**/*.{ts,tsx}": [
      "pnpm -C web exec eslint --fix",
      "pnpm -C web exec prettier --write"
    ]
  }
}
