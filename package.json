{
  "name": "clinic-booking",
  "version": "1.0.0",
  "private": true,
  "description": "Clinic booking monorepo root: git hygiene tooling only.",
  "scripts": {
    "prepare": "husky",
    "lint:md": "markdownlint-cli2"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "markdownlint-cli2": "^0.18.1"
  },
  "lint-staged": {
    "backend/**/*.py": [
      "uv run --project backend ruff check --fix --exit-non-zero-on-fix",
      "uv run --project backend ruff format"
    ],
    "apps/booking/**/*.{ts,tsx}": [
      "pnpm -C apps/booking exec eslint --fix --max-warnings=0",
      "pnpm -C apps/booking exec prettier --write"
    ],
    "**/*.md": [
      "markdownlint-cli2"
    ],
    "**/*.go": [
      "gofmt -l -w"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "unrs-resolver"
    ]
  }
}
