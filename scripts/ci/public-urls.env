# Public URLs read by the smoke-public job (no CI context, so no secrets here: URLs only).
# Fill in after the first deploy (Vercel assigns the *.vercel.app name; Cloud Run assigns the
# run.app hash). smoke-public fails fast while a placeholder remains.
WEB=https://REPLACE_AFTER_FIRST_DEPLOY
RUN_APP_URL=https://REPLACE_AFTER_FIRST_DEPLOY
