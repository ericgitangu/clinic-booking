# Public URLs read by the smoke-public job (no secrets: URLs only).
#
# Commit the real values BEFORE the first push to main (docs/runbooks/bootstrap-gcp.md, step 7):
#   WEB          the Vercel production domain, e.g. https://clinic-web.vercel.app
#   RUN_APP_URL  gcloud run services describe clinic-api --region us-east4 \
#                  --format='value(status.url)'
# smoke-public fails fast while a placeholder remains, so the first release is red at its last
# job if this file is skipped.
WEB=https://REPLACE_BEFORE_FIRST_PUSH
RUN_APP_URL=https://REPLACE_BEFORE_FIRST_PUSH
