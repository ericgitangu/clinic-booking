# Identifiers for the WIF-deny probe (scripts/ci/deny_probe.sh wif). The oidc-probe CircleCI
# context is empty by design (the keyless deploy rule), so the pool coordinates live here. None is a secret: the
# project number is already published in infra/terraform/terraform.tfvars.example, and the pool
# and provider names are in scripts/ci/gcp_login.sh.
WIF_PROJECT_NUMBER=291652953712
WIF_POOL=circleci
WIF_PROVIDER=circleci-oidc
