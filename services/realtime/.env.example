# Every variable the realtime gateway reads (services/realtime/internal/config/config.go and
# cmd/realtime/main.go). Names only, no values; unset means the default in the comment. Durations
# use Go syntax (30s, 4m). Cloud Run gets the secrets from Secret Manager. Never write a secret
# into this file.

# Port the HTTP server listens on (also the compose healthcheck). Not secret. Default 8080.
PORT=
# Connection string for the gateway's own database role (clinic_realtime, column-level SELECT). Secret. Required.
DATABASE_URL=
# Verifies the staff assertion; the same key the API and the admin app hold. Secret, 32+ bytes.
INTERNAL_SIGNING_KEY=
# Lets the release smoke open a stream as the synthetic "smoke" identity. Secret, 32+ bytes when
# set, optional.
SMOKE_SIGNING_KEY=
# Comma-separated owner emails; the same value the API and the admin app read. Not secret.
ADMIN_EMAILS=
# Streams one instance serves. Not secret. Default 1.
MAX_STREAMS_PER_INSTANCE=
# Streams one person may hold. Not secret. Default 1.
MAX_STREAMS_PER_PERSON=
# How often the gateway polls for new events. Not secret. Default 1s.
POLL_INTERVAL=
# Heartbeat comment interval; start-up refuses less than 25s (cost guard). Not secret. Default 30s.
HEARTBEAT_INTERVAL=
# Hard ceiling on one stream. Not secret. Default 290s.
MAX_CONNECTION=
# Closes a stream that has delivered no appointment event for this long. Not secret. Default 240s.
IDLE_TIMEOUT=
# How often an open stream re-reads the person's role. Not secret. Default 30s.
ROLE_RECHECK=
# Database connections per instance, 1 or 2. Not secret. Default 2.
DB_MAX_CONNS=
# Time allowed to drain on shutdown. Not secret. Default 8s.
SHUTDOWN_TIMEOUT=
# Base URL used in problem-details type links. Not secret. Default https://clinic.invalid.
PROBLEMS_BASE_URL=

# --- Tests only (internal/testenv, cmd/realtime/main_test.go; set by the Makefile) ---------------
# Owner-role and gateway-role connection strings of the test database. Secret (local throwaways).
TEST_OWNER_DSN=
TEST_REALTIME_DSN=
# Running API the integration tests call, and the signing key it was started with.
# URL is not secret; the key is.
TEST_API_URL=
TEST_API_SIGNING_KEY=
